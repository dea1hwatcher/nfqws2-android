#!/system/bin/sh
umask 077
SELF="${0%/*}"
case "$SELF" in /*) ;; *) SELF="$(cd "$SELF" 2>/dev/null && pwd)" ;; esac
MODDIR="${SELF%/bin}"
[ -f "$MODDIR/module.prop" ] || MODDIR=/data/adb/modules/nfqws2-android
. "$MODDIR/lib/common.sh"
load_conf >/dev/null 2>&1
SERVICE="$MODDIR/service.sh"

# Каталоги стратегий создаёт lib/common.sh (STRATEGIES_DIR, USER_STRATEGIES_DIR),
# a состояние — она же через load_conf/sync_lists_and_blobs. Раньше всё это
# повторялось здесь с теми же путями; оставляем только то, чего в common.sh
# действительно нет — imports/.
[ -d "$IMPORTS_DIR" ] || mkdir -p "$IMPORTS_DIR" 2>/dev/null

# Данные больше ~100 КБ одной строкой не передать: и команда для sh -c, и
# аргумент внешнего printf упираются в предел ядра на длину аргумента
# (E2BIG, «Argument list too long»). Такие данные WebUI сначала кладёт
# частями командой upload, а вместо них передаёт @up:<метка>.
UPLOAD_DIR="$STATE_DIR/upload"
upload_file() { # <@up:метка> -> путь файла или код 1
  local tk="${1#@up:}"
  case "$1" in @up:*) ;; *) return 1 ;; esac
  case "$tk" in ''|*[!a-z0-9]*) return 1 ;; esac
  printf '%s' "$UPLOAD_DIR/$tk"
}
b64d() {
  local f
  if f=$(upload_file "$1"); then
    { if command -v base64 >/dev/null 2>&1; then base64 -d; else busybox base64 -d; fi; } < "$f" 2>/dev/null
    rm -f "$f"
    return 0
  fi
  if command -v base64 >/dev/null 2>&1; then printf '%s' "$1" | base64 -d 2>/dev/null
  else printf '%s' "$1" | busybox base64 -d 2>/dev/null; fi
}
b64e() {
  if command -v base64 >/dev/null 2>&1; then base64 "$@"
  else busybox base64 "$@"; fi
}

list_file() {
  case "$1" in
    user|user.list) echo "$LISTS_DIR/user.list" ;;
    exclude|exclude.list) echo "$LISTS_DIR/exclude.list" ;;
    ipset|ipset.list) echo "$LISTS_DIR/ipset.list" ;;
    ipset_exclude|ipset_exclude.list) echo "$LISTS_DIR/ipset_exclude.list" ;;
    auto|auto.list) echo "$LISTS_DIR/auto.list" ;;
    probe_hosts|probe_hosts.list) echo "$LISTS_DIR/probe_hosts.list" ;;
    tcp16|tcp16.list) echo "$LISTS_DIR/tcp16.list" ;;
    probe_dns|probe_dns.list) echo "$LISTS_DIR/probe_dns.list" ;;
    probe_tg|probe_tg.list) echo "$LISTS_DIR/probe_tg.list" ;;
    probe_bench|probe_bench.list) echo "$LISTS_DIR/probe_bench.list" ;;
    geoblock|geoblock.list) echo "$LISTS_DIR/geoblock.list" ;;
    apps|apps.list) echo "$CONFDIR/apps.list" ;;
    home|home_wifi.list) echo "$HOME_FILE" ;;
    *) return 1 ;;
  esac
}

set_conf_param() {   # только однострочные значения
  local key="$1" val="$2" tmp="$CONFFILE.tmp.$$"
  awk -v k="$key" -v v="$val" '
    BEGIN { d = 0 }
    $0 ~ "^" k "=" { if (!d) { print k "=\"" v "\""; d = 1 } ; next }
    { print }
    END { if (!d) print k "=\"" v "\"" }' "$CONFFILE" > "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$CONFFILE" || { rm -f "$tmp"; return 1; }
  chmod 0644 "$CONFFILE"
}

# Кавычки, обратный слэш и управляющие символы ломают JSON. Именно [:cntrl:], а не
# диапазон '\000-\037': tr из toybox (Android) диапазон с восьмеричными кодами не
# понимает и удаляет его концы и сам «-», а с ним — дефисы в версии и именах.
json_str() { printf '%s' "$1" | tr -d '"\\[:cntrl:]'; }

uptime_cs() { awk '{ printf "%d", $1 * 100 }' /proc/uptime 2>/dev/null; }

# Код возврата этой функции — последний в ветках save-conf-b64/set/set-mode, поэтому if, а не &&:
# иначе сохранение успешного конфига выходило бы с 1, когда служба остановлена, и WebUI считал его ошибкой.
need_restart_note() { if is_running; then echo "Изменения применятся после перезапуска службы"; fi; }

# Строка на стратегию: имя <TAB> вид (builtin|user|import) <TAB> 1, если
# встроенная стратегия отредактирована и отличается от исходника.
list_strategies() {
  local f n kind mod
  for f in "$STRATEGIES_DIR"/*.conf "$USER_STRATEGIES_DIR"/*.conf; do
    [ -f "$f" ] || continue
    basename "$f" .conf
  done | sort -u | while IFS= read -r n; do
    [ -n "$n" ] || continue
    kind=user; mod=0
    if [ -f "$STRATEGIES_DIR/$n.conf" ]; then
      kind=builtin
      if [ -f "$USER_STRATEGIES_DIR/$n.conf" ]; then
        # Правка, совпавшая с исходником, — уже не правка: убираем копию, чтобы
        # кнопка сброса не появлялась без причины.
        if strategy_modified "$n"; then mod=1; else rm -f "$USER_STRATEGIES_DIR/$n.conf"; fi
      fi
    fi
    printf '%s\t%s\t%s\n' "$n" "$kind" "$mod"
  done
  list_imports | while IFS= read -r n; do
    if [ -n "$n" ]; then
      printf 'imp:%s\timport\t0\n' "$n"
    fi
  done
}

# Готовый nfqws2.conf для стратегии: её текст плюс настройки пользователя из
# действующего конфига (USER_KEYS в lib/common.sh).
build_strategy_conf() { # <имя> <файл-результат>
  local raw="$STATE_DIR/strat_raw.$$"
  render_strategy "$1" > "$raw" 2>/dev/null || { rm -f "$raw"; return 1; }
  [ -s "$raw" ] || { rm -f "$raw"; return 1; }
  if [ -f "$CONFFILE" ]; then merge_user_keys "$raw" "$CONFFILE" > "$2"; else cp -f "$raw" "$2"; fi
  rm -f "$raw"
}

set_strategy() {
  local name="${1:-default}" tmp="$STATE_DIR/strat_apply.$$.tmp"
  case "$name" in default) ;; imp:*) strategy_name_ok "${name#imp:}" || { echo "Некорректное имя" >&2; return 1; } ;;
    *) strategy_name_ok "$name" || { echo "Некорректное имя" >&2; return 1; } ;; esac
  if [ "$name" != "default" ] && ! strategy_file "$name" >/dev/null; then
    echo "Стратегия '$name' не найдена" >&2
    return 1
  fi
  local err
  if ! build_strategy_conf "$name" "$tmp" || ! err=$(validate_conf_file "$tmp" 2>&1); then
    echo "Ошибка валидации стратегии '$name': $err" >&2
    rm -f "$tmp"
    return 1
  fi
  cp -f "$CONFFILE" "$CONFFILE.bak" 2>/dev/null
  save_working_snapshot "$CONFFILE" 2>/dev/null || true
  mv -f "$tmp" "$CONFFILE"
  chmod 0644 "$CONFFILE"
  echo "$name" > "$ACTIVE_FILE"
  [ "$name" = smart ] || echo "$name" > "$LAST_STRATEGY_FILE"
  save_strategy_receipt "$CONFFILE" 2>/dev/null || true
  if [ "$NET_STRATEGY" = "1" ]; then
    save_net_strategy "$name" >/dev/null 2>&1
  fi
  echo "Применена стратегия: ${name#imp:}"
}

# 1 — действующий конфиг отличается от того, что дала бы повторная установка
# текущей стратегии; 0 — совпадает. Кнопка «Сбросить» в WebUI видна только при 1.
conf_modified() {
  local tmp="$STATE_DIR/conf_cmp.$$" r=1
  if build_strategy_conf "$(get_current_strategy)" "$tmp" && cmp -s "$tmp" "$CONFFILE"; then r=0; fi
  rm -f "$tmp"
  echo "$r"
}

cmd_json_status() {
  local run=false pid="" uptime=0 upms=0 cs st
  if is_running; then
    run=true
    pid=$(cat "$PIDFILE" 2>/dev/null)
    # Часы с загрузки (/proc/uptime, сотые доли секунды): перевод часов и смена
    # часового пояса их не трогают. Метки нет (служба запущена прежней
    # версией) — по date, как раньше
    st=$(cat "$STATE_DIR/started_cs" 2>/dev/null); cs=$(uptime_cs)
    case "$st$cs" in
      ''|*[!0-9]*) ;;
      *) [ "$cs" -ge "$st" ] && { upms=$(( (cs - st) * 10 )); uptime=$(( upms / 1000 )); } ;;
    esac
    if [ "$upms" = 0 ] && [ -f "$STATE_DIR/started_at" ]; then
      local now st
      now=$(date +%s)
      st=$(cat "$STATE_DIR/started_at" 2>/dev/null)
      case "$st" in
        ''|*[!0-9]*) uptime=0 ;;
        *)           uptime=$((now - st)) ;;
      esac
      [ "$uptime" -ge 0 ] 2>/dev/null || uptime=0
      upms=$(( uptime * 1000 ))
    fi
  fi
  # Ничего сверх того, что читает WebUI: раньше здесь ещё считались
  # tls_strategies/udp_strategies — два пайплайна norm_args|tr|grep|sort|sed по
  # обоим наборам аргументов на КАЖДЫЙ вызов, — плюс всегда пустой preset.
  # Ни одно из этих полей интерфейс не читал. Если диагностика по стратегиям
  # понадобится, её стоит отдавать отдельной командой, а не в статусе.
  local ver cur_strat paused pending f override=""
  ver=$(sed -n '/^version=/{s/^version=//p;q;}' "$MODDIR/module.prop")
  if [ -f "$HOME_PAUSED_FILE" ]; then
    paused=$(cat "$HOME_PAUSED_FILE" 2>/dev/null)
  fi
  [ -f "$HOME_OVERRIDE_FILE" ] && IFS= read -r override < "$HOME_OVERRIDE_FILE"
  pending=""
  for f in "$LISTS_PENDING_DIR"/*.list; do
    [ -e "$f" ] || continue
    f="${f##*/}"; pending="$pending${pending:+,}${f%.list}"
  done
  cur_strat=$(get_current_strategy)
  local qdrop
  qdrop=$(awk -v q="$NFQUEUE_NUM" '$1 == q { print $6 + $7; f = 1 } END { if (!f) print 0 }' /proc/net/netfilter/nfnetlink_queue 2>/dev/null)
  local appn cnt_user cnt_auto cnt_excl cnt_ipset cnt_ipset_excl cnt_apps cnt_geo v
  appn=$(app_uid_count 2>/dev/null)
  set -- $(list_counts "$LISTS_DIR/user.list" "$LISTS_DIR/auto.list" "$LISTS_DIR/exclude.list" \
                      "$LISTS_DIR/ipset.list" "$LISTS_DIR/ipset_exclude.list" "$CONFDIR/apps.list" \
                      "$LISTS_DIR/geoblock.list")
  cnt_user="$1" cnt_auto="$2" cnt_excl="$3" cnt_ipset="$4" cnt_ipset_excl="$5" cnt_apps="$6" cnt_geo="$7"
  local has_rb
  if [ -f "$SNAPSHOT_DIR/nfqws2.conf" ]; then has_rb=1; else has_rb=0; fi
  # нечисловое значение обваливает весь JSON и убивает WebUI, поэтому проверяем каждое поле
  for v in appn cnt_user cnt_auto cnt_excl cnt_ipset cnt_ipset_excl cnt_apps cnt_geo uptime upms qdrop \
           PKT_LIMIT_OUT PKT_LIMIT_IN BLOCK_QUIC AUTOSTART WATCHDOG IPV6_ENABLED LOG_LEVEL NFQUEUE_NUM WAKELOCK HOME_WIFI ENABLE_HOTSPOT NET_STRATEGY VPN_PAUSE META_QUIC_REJECT CALLS_BYPASS TCP_MSS_CLAMP WL_PAUSE has_rb; do
    eval "case \"\${$v}\" in ''|*[!0-9]*) $v=0 ;; esac"
  done

  cat <<JSON
{"running":$run,"pid":"$pid","uptime":$uptime,"uptime_ms":$upms,"strategy":"$(json_str "$cur_strat")","version":"$(json_str "$ver")","mode":"$(json_str "$(current_mode)")",
"limiter":"$(json_str "$(cat "$STATE_DIR/limiter" 2>/dev/null)")","pkt_limit_out":$PKT_LIMIT_OUT,"pkt_limit_in":$PKT_LIMIT_IN,"block_quic":$BLOCK_QUIC,"app_mode":"$(json_str "$APP_MODE")","autostart":$AUTOSTART,"watchdog":$WATCHDOG,"wakelock_on":$WAKELOCK,
"ipv6":$IPV6_ENABLED,"log_level":$LOG_LEVEL,"qdrop":$qdrop,"queue":$NFQUEUE_NUM,"app_uids":$appn,
"home_wifi":$HOME_WIFI,"enable_hotspot":$ENABLE_HOTSPOT,"net_strategy":$NET_STRATEGY,"vpn_pause":$VPN_PAUSE,"wl_pause":$WL_PAUSE,"meta_quic":$META_QUIC_REJECT,"calls_bypass":$CALLS_BYPASS,"tcp_mss_clamp":$TCP_MSS_CLAMP,"smart":$(smart_active && echo 1 || echo 0),"paused":"$(json_str "$paused")","home_override":"$(json_str "$override")","pending":"$(json_str "$pending")",
"has_rollback":$has_rb,
"counts":{"user":$cnt_user,"auto":$cnt_auto,"exclude":$cnt_excl,"ipset":$cnt_ipset,"ipset_exclude":$cnt_ipset_excl,"apps":$cnt_apps,"geoblock":$cnt_geo}}
JSON
}

cmd_status() {
  status_line=$(sh "$SERVICE" status)
  echo "$status_line"
  echo "Режим: $(current_mode) | Пресет: $(get_current_strategy) | QUIC-блок: $BLOCK_QUIC | Приложения: $APP_MODE"
  echo "user=$(list_count "$LISTS_DIR/user.list") auto=$(list_count "$LISTS_DIR/auto.list") exclude=$(list_count "$LISTS_DIR/exclude.list") ipset=$(list_count "$LISTS_DIR/ipset.list")"
  if is_running; then firewall_ok && echo "Правила iptables: активны" || echo "Правила iptables: ОТСУТСТВУЮТ"; fi
}

cmd_doctor() {
  row() { printf '%s\t%s\t%s\n' "$1" "$2" "$3"; }
  fmt_kb() {
    local k="$1"
    if [ "$k" -ge 1024 ] 2>/dev/null; then
      printf '%d.%d %s' "$((k / 1024))" "$(( (k % 1024) * 10 / 1024 ))" "$(M МБ MB)"
    else
      printf '%d %s' "$k" "$(M КБ KB)"
    fi
  }
  local arch
  [ "$(id -u)" = "0" ] && row ok root "uid 0" || row fail root "$(M 'нужен root' 'root required')"
  arch=$(getprop ro.product.cpu.abi 2>/dev/null)
  row ok abi "$arch, $(M ядро kernel) $(uname -r)"
  [ -x "$NFQWS_BIN" ] && row ok nfqws2 "$(ls -l "$NFQWS_BIN" | awk '{print $5}') $(M байт bytes)" \
    || row fail nfqws2 "$(M 'бинарник не найден или не исполняемый' 'binary is missing or not executable')"
  if [ -x "$NFQWS_BIN" ]; then
    local _dry_err
    if _dry_err=$(validate_conf_file "$CONFFILE" 2>&1); then
      row ok dry_run "$(M 'параметры nfqws2 валидны (--dry-run)' 'nfqws2 parameters valid (--dry-run)')"
    else
      row fail dry_run "$(M "ошибка параметров: $_dry_err" "parameter error: $_dry_err")"
    fi
  fi
  command -v iptables >/dev/null 2>&1 && row ok iptables "$(M есть present)" || row fail iptables "$(M 'не найден' 'not found')"
  command -v ip6tables >/dev/null 2>&1 && row ok ip6tables "$(M есть present)" || row warn ip6tables "$(M 'нет — отключите обработку IPv6' 'missing — turn IPv6 processing off')"
  has_ipt_feature iptables -p tcp --dport 65000 -j NFQUEUE --queue-num "$NFQUEUE_NUM" --queue-bypass \
    && row ok NFQUEUE "$(M 'цель NFQUEUE доступна' 'NFQUEUE target available')" \
    || row fail NFQUEUE "$(M 'ядро без NFQUEUE — модуль работать НЕ БУДЕТ' 'kernel has no NFQUEUE — the module will NOT work')"
  has_ipt_feature iptables -p tcp -m multiport --dports 80,443 -j RETURN \
    && row ok multiport "$(M есть present)" \
    || row warn multiport "$(M 'нет xt_multiport — правила ставятся по одному порту' 'no xt_multiport — rules are added per port')"
  local lim
  lim=$(detect_limiter iptables)
  case "$lim" in
    connbytes)   row ok limiter "$(M "есть connbytes: лимит исх. $PKT_LIMIT_OUT / вх. $PKT_LIMIT_IN пак. на соединение" "connbytes present: limit out $PKT_LIMIT_OUT / in $PKT_LIMIT_IN packets per connection")" ;;
    connmark_out) row warn limiter "$(M "нет connbytes: лимит вх./исх. $PKT_LIMIT_IN/$PKT_LIMIT_OUT пак. на соединение через CONNMARK" "no connbytes: in/out limit $PKT_LIMIT_IN/$PKT_LIMIT_OUT packets per connection via CONNMARK")" ;;
  esac
  row ok quota "$(M "квоты пакетов: исх. $PKT_LIMIT_OUT / вх. $PKT_LIMIT_IN ($lim)" "packet quotas: out $PKT_LIMIT_OUT / in $PKT_LIMIT_IN ($lim)")"
  row ok auto_ports "$(M "активные порты: TCP: ${TCP_PORTS:-80,443} | UDP: ${UDP_PORTS:-443}" "active ports: TCP: ${TCP_PORTS:-80,443} | UDP: ${UDP_PORTS:-443}")"
  if [ "$NAT_FIX" = "1" ]; then
    local nat_hits
    nat_hits=$(iptables -w -t nat -L "$IPT_GROUP_NAT" -n -v -x 2>/dev/null | awk '$1 ~ /^[0-9]+$/ && $3 == "MASQUERADE" { n++; total += $1 } END { if (n) printf "%.0f", total }')
    if [ -n "$nat_hits" ]; then
      row info nat_fix "$(M "правило NAT fix на месте; пакетов прошло: $nat_hits" "NAT fix rule in place; packets matched: $nat_hits")"
    else
      row info nat_fix "$(M 'правило NAT fix не найдено (служба остановлена?)' 'NAT fix rule not found (service stopped?)')"
    fi
  fi
  if [ "$IPV6_ENABLED" = "1" ]; then
    if _firewall_family_ok ip6tables; then
      row ok ipv6_rules "$(M 'правила IPv6 установлены' 'IPv6 rules installed')"
    else
      row fail ipv6_rules "$(M 'правила IPv6 не установлены — IPv6 не перехватывается' 'IPv6 rules missing — IPv6 traffic is not intercepted')"
    fi
  fi
  local orch_doc
  orch_doc=$(grep -c '^[[:space:]]*"[^"]*":' "$ORCHESTRA_MEMORY_FILE" 2>/dev/null || :)
  [ -n "$orch_doc" ] || orch_doc=0
  row ok orchestra "$(M "память оркестратора: $orch_doc хостов" "orchestrator memory: $orch_doc hosts")"
  has_ipt_feature iptables -m owner --uid-owner 0 -j RETURN \
    && row ok owner "$(M 'фильтр приложений доступен' 'app filter available')" \
    || row warn owner "$(M 'нет xt_owner — фильтр приложений не сработает' 'no xt_owner — app filter will not work')"
  if app_mode_active; then
    local n=$(app_uid_count)
    if [ "$n" = "0" ]; then
      row warn apps "$(M "режим $APP_MODE, но apps.list не разрешился в UID ($(list_count "$CONFDIR/apps.list") пакетов)" "mode $APP_MODE, but apps.list resolved to no UID ($(list_count "$CONFDIR/apps.list") packages)")"
    else
      row ok apps "$(M "режим $APP_MODE, $n UID" "mode $APP_MODE, $n UID")"
    fi
  else
    row info apps "$(M 'фильтр по приложениям выключен' 'app filter is off')"
  fi
  if [ -e /proc/sys/net/netfilter/nf_conntrack_checksum ]; then
    local est cnt mx
    est=$(sysctl -n net.netfilter.nf_conntrack_tcp_timeout_established 2>/dev/null)
    cnt=$(sysctl -n net.netfilter.nf_conntrack_count 2>/dev/null)
    mx=$(sysctl -n net.netfilter.nf_conntrack_max 2>/dev/null)
    row ok conntrack "timeout_established=${est:-?}$(M с s), $(M записей entries) ${cnt:-?}/${mx:-?}"
  else
    row warn conntrack "$(M 'нет nf_conntrack sysctl' 'no nf_conntrack sysctl')"
  fi
  if [ "$ENABLE_HOTSPOT" = "1" ]; then
    if command -v settings >/dev/null 2>&1; then
      local to_val
      to_val=$(settings get global tether_offload_disabled 2>/dev/null)
      if [ "$to_val" = "1" ]; then
        row ok hotspot "$(M 'точка доступа: аппаратный оффлоад отключен' 'hotspot: hardware offload disabled')"
      else
        row warn hotspot "$(M 'точка доступа: оффлоад включен' 'hotspot: hardware offload enabled')"
      fi
    else
      row info hotspot "$(M 'обход для точки доступа включен' 'hotspot bypass enabled')"
    fi
  else
    row info hotspot "$(M 'обход для точки доступа выключен' 'hotspot bypass disabled')"
  fi
  if is_running; then
    local _pid _cg _rss _hwm _ram_text
    _pid=$(cat "$PIDFILE" 2>/dev/null)
    row ok process "nfqws2 PID $_pid"
    if [ -n "$_pid" ] && [ -d "/proc/$_pid" ]; then
      _rss=$(awk '/^VmRSS:/ { print $2 }' "/proc/$_pid/status" 2>/dev/null)
      _hwm=$(awk '/^VmHWM:/ { print $2 }' "/proc/$_pid/status" 2>/dev/null)
      if [ -z "$_rss" ] && [ -r "/proc/$_pid/statm" ]; then
        local _res_pages
        _res_pages=$(awk '{ print $2 }' "/proc/$_pid/statm" 2>/dev/null)
        [ -n "$_res_pages" ] && _rss=$(( _res_pages * 4 ))
      fi
      if [ -n "$_rss" ] && [ "$_rss" -ge 0 ] 2>/dev/null; then
        _ram_text="$(fmt_kb "$_rss") (VmRSS: ${_rss} $(M КБ KB))"
        if [ -n "$_hwm" ] && [ "$_hwm" -gt "$_rss" ] 2>/dev/null; then
          _ram_text="$_ram_text, $(M пик peak) $(fmt_kb "$_hwm")"
        fi
        row ok "$(M 'ОЗУ' 'RAM')" "$_ram_text"
      else
        row info "$(M 'ОЗУ' 'RAM')" "$(M 'не удалось определить' 'could not determine')"
      fi
    else
      row info "$(M 'ОЗУ' 'RAM')" "$(M 'процесс недоступен в /proc' 'process unavailable in /proc')"
    fi
    _cg=$(cat "/proc/$_pid/cgroup" 2>/dev/null | tr '\n' ' ')
    row info cgroup "${_cg:-$(M недоступно unavailable)}"
  elif [ "$(cat "$HOME_PAUSED_FILE" 2>/dev/null)" = "@vpn" ]; then
    row info process "$(M "пауза: активен VPN" "paused: VPN active")"
    row info "$(M 'ОЗУ' 'RAM')" "$(M 'пауза' 'paused')"
  elif [ "$(cat "$HOME_PAUSED_FILE" 2>/dev/null)" = "@wl" ]; then
    row info process "$(M 'пауза: у оператора белые списки' 'paused: the operator turned on white lists')"
    row info "$(M 'ОЗУ' 'RAM')" "$(M 'пауза' 'paused')"
  elif [ -f "$HOME_PAUSED_FILE" ]; then
    row info process "$(M "пауза: домашняя Wi-Fi «$(cat "$HOME_PAUSED_FILE")»" "paused: home Wi-Fi “$(cat "$HOME_PAUSED_FILE")”")"
    row info "$(M 'ОЗУ' 'RAM')" "$(M 'пауза' 'paused')"
  else
    row info process "$(M 'не запущен' 'not running')"
    row info "$(M 'ОЗУ' 'RAM')" "$(M 'не запущен' 'not running')"
  fi
  if grep -q "nfqws2-android" /sys/power/wake_lock 2>/dev/null; then
    row ok wakelock "$(M удерживается held)"
  elif [ "$WAKELOCK" = "1" ]; then
    row warn wakelock "$(M 'включён в настройках, но не удерживается' 'enabled in settings, but not held')"
  else
    row info wakelock "$(M выключен off)"
  fi
  if [ -f "$WN_PIDFILE" ] && kill -0 "$(cat "$WN_PIDFILE" 2>/dev/null)" 2>/dev/null; then
    row ok netwatch "$(M 'работает: мгновенная реакция на смену сети' 'running: instant reaction to network changes')"
  elif [ "$WATCHDOG" != "1" ] && [ "$HOME_WIFI" != "1" ] && [ "$NET_STRATEGY" != "1" ] && [ "$VPN_PAUSE" != "1" ]; then
    row info netwatch "$(M 'выключен вместе с контролем работы' 'off together with the watchdog')"
  elif command -v ip >/dev/null 2>&1; then
    row warn netwatch "$(M 'не запущен — правила обновятся только по watchdog (раз в 20 сек)' 'not running — rules are refreshed by the watchdog only (every 20 s)')"
  else
    row info netwatch "$(M 'команда ip недоступна — работает только опрос watchdog' 'ip command unavailable — watchdog polling only')"
  fi
  if is_running; then
    local qn
    qn=$(cat /proc/net/netfilter/nfnetlink_queue 2>/dev/null | awk -v q="$NFQUEUE_NUM" '$1 == q { print }')
    if [ -n "$qn" ]; then
      set -- $qn
      if [ "${6:-0}" -gt 0 ] || [ "${7:-0}" -gt 0 ]; then
        row fail queue "$(M "переполнение очереди: сброшено ядром $6, ошибок доставки $7 — nfqws2 не успевает" "queue overflow: $6 dropped by kernel, $7 delivery errors — nfqws2 can't keep up")"
      else
        row ok queue "$(M 'работает, переполнений нет' 'working, no overflows')"
      fi
    else
      row fail queue "$(M "процесс запущен, но НЕ привязан к очереди $NFQUEUE_NUM" "process is running but NOT bound to queue $NFQUEUE_NUM")"
    fi
    # Сам переход в nfqws_post ещё не значит, что пакеты попадут в очередь: на
    # ядре без нужного match все правила перехвата могли не встать (так было на
    # ядрах без xt_multiport). Считаем именно правила, ведущие в очередь.
    local nq
    nq=$(iptables -w -t mangle -S $IPT_GROUP_POST 2>/dev/null | grep -cE -- '-j (NFQUEUE|nfqws_qout)')
    if firewall_ok; then
      row ok rules "$(M "правила iptables на месте, в очередь ведут $nq" "iptables rules in place, $nq lead to the queue")"
    else
      row fail rules "$(M 'нет правил, отправляющих пакеты в очередь — nfqws2 их не увидит' 'no rules send packets to the queue — nfqws2 will see nothing')"
    fi
  fi
  if [ "$LOG_LEVEL" = "1" ]; then row warn debug "$(M 'включён подробный журнал — обработка заметно медленнее' 'verbose log is on — processing is noticeably slower')"; fi
}

cmd_apply_apps() {
  [ -f "$SERVICE" ] || { echo "Не найден $SERVICE" >&2; return 1; }
  if ! app_mode_active; then
    rm -f "$APP_UIDS_FILE"
    is_running && sh "$SERVICE" firewall_apply >/dev/null 2>&1
    echo "Фильтр по приложениям выключен"
    return 0
  fi
  if ! app_features_ok iptables; then
    echo "Ядро не поддерживает xt_owner/xt_CONNMARK — фильтр по приложениям невозможен" >&2
    return 1
  fi
  printf '%s\n' "$(resolve_app_uids)" > "$APP_UIDS_FILE"
  local n=$(app_uid_count)
  if [ "$n" = "0" ]; then
    echo "Ни один пакет из apps.list не сопоставлен с UID (проверьте имена пакетов)" >&2
    return 1
  fi
  if is_running; then
    sh "$SERVICE" firewall_apply >/dev/null 2>&1 || { echo "Не удалось применить правила iptables" >&2; return 1; }
    echo "Фильтр по приложениям ($APP_MODE): $n UID"
  else
    echo "Фильтр по приложениям ($APP_MODE): $n UID — правила применятся при запуске службы"
  fi
}

cmd_import_add() { # $1 = имя, $2 = путь к файлу с содержимым
  local name="$1" src="$2" safe
  [ -f "$src" ] || { echo "Нет данных для импорта" >&2; return 1; }
  tr -d '\r' < "$src" > "$src.n" && mv -f "$src.n" "$src"

  if ! is_keenetic_config "$src"; then
    echo "Похоже, это не конфиг nfqws2-keenetic: не нашлось ни одной из переменных NFQWS_ARGS / NFQWS_BASE_ARGS / ISP_INTERFACE / TCP_PORTS и т.п." >&2
    return 1
  fi
  if ! validate_conf "$src" >/dev/null 2>&1; then
    echo "Файл отклонён: $(validate_conf "$src" 2>&1 | head -n1)" >&2
    return 1
  fi

  [ -n "$name" ] || name="import-$(date '+%Y%m%d-%H%M%S' 2>/dev/null)"
  safe=$(import_safe_name "$name")
  [ -n "$safe" ] || safe="import-$(date '+%Y%m%d-%H%M%S' 2>/dev/null)"
  local dst="$IMPORTS_DIR/$safe.conf" n=1
  while [ -f "$dst" ]; do dst="$IMPORTS_DIR/${safe}_$n.conf"; n=$((n + 1)); done
  # Импорт хранится уже в виде встроенной стратегии (см. normalize_import):
  # редактор показывает его тем же, а смена стратегии не трогает настройки.
  if ! normalize_import "$src" > "$dst" || ! grep -q '^NFQWS_ARGS=' "$dst" || ! validate_conf "$dst" >/dev/null 2>&1; then
    rm -f "$dst"
    echo "Не удалось привести конфиг к виду стратегии" >&2
    return 1
  fi
  chmod 0644 "$dst"
  echo "$(basename "$dst" .conf)"
  # Вторая строка — для WebUI: какие параметры убраны при импорте
  local bad
  bad=$(unsupported_opts "$src" | sed 's/^/--/' | tr '\n' ' ' | sed 's/ $//')
  if [ -n "$bad" ]; then
    log_msg "Import «$(basename "$dst" .conf)»: removed parameters not supported in this nfqws2 build: $bad" >/dev/null
    printf 'removed\t%s\n' "$bad"
  fi
}

# Строки, которые фильтр «Ошибки» в WebUI считает ошибками
ERR_RE='ошибк|не удал|не запуст|упал|не активен|отсутству|отклон|error|fail|fatal|denied|refused|cannot|could not|unable'

cmd_get_logs() { # <источник> <строк> [errors]
  local n="${2:-100}" f
  case "$n" in ''|*[!0-9]*) n=100 ;; esac
  [ "$1" = "summary" ] && { cmd_log_summary; return; }
  case "$1" in
    nfqws) f="$NFQWS_LOG" ;; debug) f="$LOG_DIR/nfqws2-debug.log" ;; auto) f="$LOG_DIR/auto.log" ;;
    args) f="$ARGS_FILE" ;; *) f="$SERVICE_LOG" ;;
  esac
  if [ ! -s "$f" ]; then echo "$(M '(пусто)' '(empty)')"; return 0; fi
  if [ "$3" = "errors" ]; then
    grep -iE "$ERR_RE" "$f" | tail -n "$n" | grep . || echo "$(M '(ошибок нет)' '(no errors)')"
  else
    tail -n "$n" "$f"
  fi
}

# «Краткая статистика»: главное из service.log и auto.log одной таблицей.
# Строка: вид (ok|warn|fail|info) <TAB> заголовок <TAB> подробность.
cmd_log_summary() {
  local svc="$SERVICE_LOG" auto="$LOG_DIR/auto.log"
  local L="${NFQWS_LANG:-ru}"
  if [ -s "$svc" ]; then
    awk -v L="$L" '
      function T(ru, en) { return L == "en" ? en : ru }
      function ts(line,   e) { e = index(line, "]"); return (substr(line, 1, 1) == "[" && e) ? substr(line, 2, e - 2) : "" }
      function msg(line,   e) { e = index(line, "] "); return (substr(line, 1, 1) == "[" && e) ? substr(line, e + 2) : line }
      /nfqws2 (запущен|started)/              { last_start = ts($0); m = msg($0); pid = ""; if (match(m, /PID [0-9]+/)) pid = substr(m, RSTART, RLENGTH); last_ev = "start" }
      /nfqws2 (остановлен|stopped)/           { last_stop = ts($0); last_ev = "stop" }
      /(обход приостановлен|bypass paused)/   { last_pause = ts($0); last_ev = "pause"; pmsg = msg($0) }
      /watchdog: nfqws2 (упал|не активен|is inactive)/ { crash++; last_crash = ts($0) }
      /netwatch: (сеть изменилась|network changed)/ { net++ }
      /(правила iptables сброшены системой|watchdog: iptables rules flushed by system)/ { lost++ }
      /(Ошибка|не удался|Не удалось|Error|failed|Failed)/ { err++; last_err = msg($0); last_err_ts = ts($0) }
      END {
        if (last_ev == "start") printf "ok\t%s\t%s\n", T("nfqws2 запущен", "nfqws2 started"), last_start (pid != "" ? " · " pid : "")
        else if (last_ev == "stop") printf "info\t%s\t%s\n", T("nfqws2 остановлен", "nfqws2 stopped"), last_stop
        else if (last_ev == "pause") printf "info\t%s\t%s\n", (pmsg ~ /(Активен VPN|Включён VPN|VPN active)/ ? T("Пауза: активен VPN", "Paused: VPN active") : T("Пауза в домашней Wi-Fi", "Paused on home Wi-Fi")), last_pause
        if (crash) printf "warn\t%s\t%s\n", T("Автоперезапусков: ", "Automatic restarts: ") crash, T("последний ", "last ") last_crash
        if (net) printf "info\t%s\t%s\n", T("Пересборок правил при смене сети: ", "Rule rebuilds on network change: ") net, ""
        if (lost) printf "info\t%s\t%s\n", T("Правила восстановлены после сброса системой: ", "Rules restored after a system reset: ") lost, ""
        if (err) printf "fail\t%s\t%s\n", T("Ошибок в журнале: ", "Errors in the log: ") err, last_err_ts " · " last_err
        else printf "ok\t%s\t%s\n", T("Ошибок в журнале службы нет", "No errors in the service log"), ""
      }' "$svc"
  else
    printf 'info\t%s\t\n' "$(M 'Журнал службы пуст' 'Service log is empty')"
  fi
  if [ -s "$auto" ]; then
    # Формат nfqws2: [дата : ]хост : profile N (имя) : client … : proto … : событие
    awk -F ' : ' -v L="$L" '
      function T(ru, en) { return L == "en" ? en : ru }
      {
        i = 1; when = ""
        if ($1 ~ /^[0-9][0-9]\.[0-9][0-9]\.[0-9]+ [0-9:]+$/) { when = $1; i = 2 }
        host = $i
        if (host !~ /\./ || host ~ / /) next
        ev = $NF
        if (ev ~ /^fail counter [0-9]+\/[0-9]+/) { split(substr(ev, 14), c, " "); cnt[host] = c[1]; seen[host] = when }
        else if (ev ~ /^adding to /) { n++; add_host[n] = host; add_when[n] = when; added[host] = 1 }
        else if (ev ~ /website is working/) { ok++; delete cnt[host] }
      }
      END {
        if (n) printf "info\t%s\t\n", T("Добавлено в auto.list: ", "Added to auto.list: ") n
        shown = 0
        for (k = n; k >= 1 && shown < 15; k--) {
          h = add_host[k]; if (h in printed) continue; printed[h] = 1; shown++
          printf "ok\t%s\t%s\n", h, T("добавлен в auto.list", "added to auto.list") (h in cnt ? " · " cnt[h] : "") (add_when[k] != "" ? " · " add_when[k] : "")
        }
        for (h in cnt) if (!(h in added)) printf "warn\t%s\t%s\n", h, T("неудачных попыток ", "failed attempts ") cnt[h] (seen[h] != "" ? " · " seen[h] : "")
        if (ok) printf "info\t%s\t\n", T("Сайтов заработало после сбоев: ", "Sites recovered after failures: ") ok
        nc = 0; for (h in cnt) nc++
        if (!n && !ok && !nc) printf "info\t%s\t\n", T("Автообучение пока ничего не нашло", "Auto-learning has found nothing yet")
      }' "$auto"
  else
    printf 'info\t%s\t\n' "$(M 'Журнал автообучения пуст' 'Auto-learning log is empty')"
  fi
}

cmd_export_logs() {
  local tmp="$STATE_DIR/export_logs.$$" name="nfqws2-logs-$(date '+%Y%m%d-%H%M%S').tar"
  rm -rf "$tmp"; mkdir -p "$tmp" 2>/dev/null || return 1
  cp -f "$LOG_DIR"/* "$tmp"/ 2>/dev/null
  cp -f "$ARGS_FILE" "$tmp/last.args" 2>/dev/null
  cmd_doctor > "$tmp/doctor.txt" 2>&1
  iptables-save -t mangle 2>/dev/null | grep -i nfqws > "$tmp/iptables-nfqws.txt"
  # Счётчики пакетов по правилам и состояние очереди: по ним видно, доходит ли
  # трафик до правил и до nfqws2, даже когда журнал самого nfqws2 молчит.
  {
    for c in $IPT_GROUP_POST $IPT_GROUP_PRE $IPT_GROUP_QOUT $IPT_GROUP_QIN; do
      echo "== iptables -t mangle -L $c -v -n"; iptables -w -t mangle -L "$c" -v -n -x 2>&1
    done
    echo "== ip6tables -t mangle -L $IPT_GROUP_POST -v -n"; ip6tables -w -t mangle -L $IPT_GROUP_POST -v -n -x 2>&1
    echo "== /proc/net/netfilter/nfnetlink_queue"; cat /proc/net/netfilter/nfnetlink_queue 2>&1
    echo "== ip route"; ip route 2>&1; ip -6 route 2>&1 | head -n 20
  } > "$tmp/counters.txt" 2>&1

  mkdir -p "$BACKUP_DIR" 2>/dev/null
  local out_file="$BACKUP_DIR/$name"
  if (cd "$tmp" && tar_cmd -cf "$out_file" .) 2>/dev/null; then
    printf '%s\t%s\t' "$name" "$out_file"
    b64e < "$out_file" | tr -d '\r\n'
    printf '\n'
    # log exports are regenerable snapshots: keep the newest 10. Backups are the
    # user's own copies and are never deleted here
    ls -1t "$BACKUP_DIR"/nfqws2-logs-*.tar 2>/dev/null | tail -n +11 | while IFS= read -r old; do rm -f "$old"; done
  else
    local d="$BACKUP_DIR/nfqws2-logs"
    mkdir -p "$d" 2>/dev/null
    cp -f "$tmp"/* "$d"/ 2>/dev/null
    echo "Логи сохранены в $d"
  fi
  rm -rf "$tmp"
}

cmd_list_apps() {
  local cache="$STATE_DIR/apps_cache.json"
  local refresh=0
  case "${1:-}" in refresh|--refresh|-f) refresh=1 ;; esac
  [ -f "$cache" ] || refresh=1

  # Автоматическая проверка актуальности кэша при установке/удалении приложений
  if [ "$refresh" = "0" ] && [ -s "$cache" ]; then
    local ref
    for ref in /data/system/packages.list /data/system/packages.xml /data/app; do
      if [ -e "$ref" ] && [ "$ref" -nt "$cache" ] 2>/dev/null; then
        refresh=1
        break
      fi
    done
    if [ "$refresh" = "0" ]; then
      cat "$cache"
      return 0
    fi
  fi

  local target="$MODDIR/bin/pkglist.jar"
  [ -f "$target" ] || target="$MODDIR/bin/pkglist.dex"
  [ -f "$target" ] || target="/data/adb/modules/nfqws2-android/bin/pkglist.jar"
  [ -f "$target" ] || target="/data/adb/modules/nfqws2-android/bin/pkglist.dex"

  if [ -f "$target" ] && command -v app_process >/dev/null 2>&1; then
    mkdir -p "$STATE_DIR" 2>/dev/null
    local tmp="$cache.tmp.$$"
    rm -f "$tmp" 2>/dev/null
    CLASSPATH="$target" app_process /system/bin com.deathwatcher.PkgList --out "$tmp" --apps-list "$CONFDIR/apps.list" >/dev/null 2>&1
    if [ -s "$tmp" ] && grep -q '^\[' "$tmp" 2>/dev/null; then
      mv -f "$tmp" "$cache"
      cat "$cache"
      return 0
    fi
    rm -f "$tmp" 2>/dev/null

    local out
    out=$(CLASSPATH="$target" app_process /system/bin com.deathwatcher.PkgList --apps-list "$CONFDIR/apps.list" 2>/dev/null)
    if [ -n "$out" ] && [ "${out#\[}" != "$out" ]; then
      printf '%s\n' "$out" > "$cache" 2>/dev/null
      printf '%s\n' "$out"
      return 0
    fi
  fi

  # Если генерация не удалась, но у нас уже есть сохраненный кэш — сохраняем его,
  # чтобы не сбрасывать пользователю названия и иконки приложений
  if [ -s "$cache" ]; then
    cat "$cache"
    return 0
  fi

  # Резервный вариант через pm (только если кэша вообще не было и app_process недоступен)
  local PM=pm
  command -v pm >/dev/null 2>&1 || PM=/system/bin/pm
  if command -v "$PM" >/dev/null 2>&1; then
    { printf '['
      "$PM" list packages -3 2>/dev/null | sed 's/^package://' | sort |
        awk 'NF { printf "%s\"%s\"", (n++ ? "," : ""), $0 }'
      printf ']\n'; }
  fi
}

# ---------------------------------------------------------------- резервная копия
# Архив в Download: конфиг, пользовательские списки (сервисные приходят с
# релизом и в копию не входят), apps.list, домашние сети, правки стратегий,
# импорты, активная стратегия и настройки WebUI (ui.json, их передаёт WebUI).
BACKUP_DIR="${NFQWS_BACKUP_DIR:-/sdcard/Download}"
BACKUP_LISTS="user exclude ipset ipset_exclude auto probe_hosts tcp16 probe_dns probe_tg probe_bench"
tar_cmd() {
  if command -v tar >/dev/null 2>&1; then tar "$@"; else busybox tar "$@"; fi
}
cmd_backup_create() { # [ui.json в base64]
  local tmp="$STATE_DIR/backup.$$" name f
  name="nfqws2-backup-$(date '+%Y%m%d-%H%M%S').tar"
  mkdir -p "$BACKUP_DIR" 2>/dev/null || { echo "Нет доступа к $BACKUP_DIR" >&2; return 1; }
  rm -rf "$tmp"; mkdir -p "$tmp/lists" "$tmp/strategies" "$tmp/imports" || return 1
  printf 'nfqws2-backup 1\n%s\n' "$(sed -n 's/^version=//p' "$MODDIR/module.prop" | head -n1)" > "$tmp/BACKUP"
  cp -f "$CONFFILE" "$tmp/nfqws2.conf" 2>/dev/null
  for f in $BACKUP_LISTS; do cp -f "$LISTS_DIR/$f.list" "$tmp/lists/" 2>/dev/null; done
  cp -f "$CONFDIR/apps.list" "$tmp/" 2>/dev/null
  cp -f "$HOME_FILE" "$tmp/" 2>/dev/null
  cp -f "$ACTIVE_FILE" "$tmp/" 2>/dev/null
  cp -f "$USER_STRATEGIES_DIR"/*.conf "$tmp/strategies/" 2>/dev/null
  cp -f "$IMPORTS_DIR"/*.conf "$tmp/imports/" 2>/dev/null
  [ -n "$1" ] && b64d "$1" > "$tmp/ui.json"
  if ! (cd "$tmp" && tar_cmd -cf "$BACKUP_DIR/$name" .) 2>/dev/null; then
    rm -rf "$tmp" "$BACKUP_DIR/$name"
    echo "Не удалось создать архив" >&2
    return 1
  fi
  rm -rf "$tmp"
  printf '%s\t%s\t' "$name" "$BACKUP_DIR/$name"
  b64e < "$BACKUP_DIR/$name" | tr -d '\r\n'
  printf '\n'
}
cmd_backup_list() {
  ls -1t "$BACKUP_DIR"/nfqws2-backup-*.tar 2>/dev/null | while IFS= read -r f; do
    printf '%s\t%s\n' "${f##*/}" "$(wc -c < "$f" 2>/dev/null | tr -d ' ')"
  done
}
_apply_restored_backup() { # <tmp dir>
  local tmp="$1" f
  if [ -f "$tmp/nfqws2.conf" ]; then
    if ! validate_conf "$tmp/nfqws2.conf" >/dev/null 2>&1; then
      rm -rf "$tmp"; echo "Конфиг в архиве не прошёл проверку" >&2; return 1
    fi
    cp -f "$CONFFILE" "$CONFFILE.bak" 2>/dev/null
    cp -f "$tmp/nfqws2.conf" "$CONFFILE" && chmod 0644 "$CONFFILE"
  fi
  for f in $BACKUP_LISTS; do
    [ -f "$tmp/lists/$f.list" ] && cp -f "$tmp/lists/$f.list" "$LISTS_DIR/$f.list" && chmod 0644 "$LISTS_DIR/$f.list"
  done
  [ -f "$tmp/apps.list" ] && cp -f "$tmp/apps.list" "$CONFDIR/apps.list"
  [ -f "$tmp/home_wifi.list" ] && cp -f "$tmp/home_wifi.list" "$HOME_FILE"
  [ -f "$tmp/active_strategy" ] && cp -f "$tmp/active_strategy" "$ACTIVE_FILE"
  for f in "$tmp"/strategies/*.conf; do [ -f "$f" ] && validate_conf "$f" >/dev/null 2>&1 && cp -f "$f" "$USER_STRATEGIES_DIR/"; done
  for f in "$tmp"/imports/*.conf; do [ -f "$f" ] && validate_conf "$f" >/dev/null 2>&1 && cp -f "$f" "$IMPORTS_DIR/"; done
  [ -s "$tmp/ui.json" ] && b64e < "$tmp/ui.json" | tr -d '\n'
  echo
  rm -rf "$tmp"
  load_conf >/dev/null 2>&1
  app_mode_active && printf '%s\n' "$(resolve_app_uids)" > "$APP_UIDS_FILE"
  if is_running; then sh "$SERVICE" restart >/dev/null 2>&1 || echo "Копия восстановлена, но служба не перезапустилась" >&2; fi
  return 0
}
cmd_backup_restore() { # <имя файла в Download>  -> stdout: ui.json в base64 (если был)
  local name="$1" tmp="$STATE_DIR/restore.$$"
  case "$name" in nfqws2-backup-*.tar) ;; *) echo "Некорректное имя архива" >&2; return 1 ;; esac
  case "$name" in */*) echo "Некорректное имя архива" >&2; return 1 ;; esac
  [ -f "$BACKUP_DIR/$name" ] || { echo "Архив не найден" >&2; return 1; }
  rm -rf "$tmp"; mkdir -p "$tmp" || return 1
  if ! (cd "$tmp" && tar_cmd -xf "$BACKUP_DIR/$name") 2>/dev/null || ! grep -q '^nfqws2-backup ' "$tmp/BACKUP" 2>/dev/null; then
    rm -rf "$tmp"; echo "Это не резервная копия nfqws2" >&2; return 1
  fi
  _apply_restored_backup "$tmp"
}
cmd_backup_restore_b64() { # <base64 tar data> -> stdout: ui.json в base64 (если был)
  local tmp="$STATE_DIR/restore.$$"
  [ -n "$1" ] || { echo "Пустые данные архива" >&2; return 1; }
  rm -rf "$tmp"; mkdir -p "$tmp" || return 1
  if ! (b64d "$1" | (cd "$tmp" && tar_cmd -xf -)) 2>/dev/null || ! grep -q '^nfqws2-backup ' "$tmp/BACKUP" 2>/dev/null; then
    rm -rf "$tmp"; echo "Это не резервная копия nfqws2" >&2; return 1
  fi
  _apply_restored_backup "$tmp"
}

# ---------------------------------------------------------------- проверка доступности
# Проверка идёт с устройства, а не из WebView: у WebView соединения живут в
# общем пуле браузера, и повторная попытка (и «Проверить снова» после смены
# стратегии) шла по уже открытому соединению — то есть не проверяла ничего.
# Здесь каждая попытка — новый процесс и новое TLS-соединение.
probe_tool() {
  local b
  if command -v curl >/dev/null 2>&1; then echo "curl $(command -v curl)"; return 0; fi
  for b in /data/adb/ksu/bin/busybox /data/adb/ap/bin/busybox /data/adb/magisk/busybox "$(command -v busybox 2>/dev/null)"; do
    [ -n "$b" ] && [ -x "$b" ] || continue
    "$b" wget --help 2>&1 | grep -q 'no-check-certificate' && { echo "wget $b"; return 0; }
  done
  echo "none"
  return 1
}
PROBE_APP_RULE=""
setup_probe_app_rule() {
  if is_running && [ "$APP_MODE" = "include" ] && iptables -w -t mangle -L $IPT_GROUP_APP -n >/dev/null 2>&1; then
    PROBE_APP_RULE="-m owner --uid-owner 0 -j CONNMARK --set-xmark $MARK_INCLUDE"
    iptables -w -t mangle -I $IPT_GROUP_APP 1 $PROBE_APP_RULE 2>/dev/null
    [ "$IPV6_ENABLED" != "0" ] && ip6tables -w -t mangle -I $IPT_GROUP_APP 1 $PROBE_APP_RULE 2>/dev/null
  fi
}
cleanup_probe_app_rule() {
  if [ -n "$PROBE_APP_RULE" ]; then
    iptables -w -t mangle -D $IPT_GROUP_APP $PROBE_APP_RULE 2>/dev/null
    [ "$IPV6_ENABLED" != "0" ] && ip6tables -w -t mangle -D $IPT_GROUP_APP $PROBE_APP_RULE 2>/dev/null
    PROBE_APP_RULE=""
  fi
}

resolve_probe_target() { # <host[/path]> -> resolved target
  local target="$1"
  case "$target" in
    googlevideo.com|www.googlevideo.com|googlevideo.com/*|www.googlevideo.com/*)
      local gv_host
      gv_host=$(resolve_googlevideo_cdn 2>/dev/null)
      if [ -n "$gv_host" ]; then
        case "$target" in
          */*) target="$gv_host/${target#*/}" ;;
          *) target="$gv_host" ;;
        esac
      fi
      ;;
  esac
  printf '%s' "$target"
}

is_block_notice() { # <body_file> -> return 0 if block page/stub, 1 otherwise
  local f="$1"
  [ -f "$f" ] && [ -s "$f" ] || return 1
  local title
  title=$(head -c 8192 "$f" 2>/dev/null | tr '\n\r' '  ' | sed -n 's/.*<title[^>]*>\(.*\)<\/title>.*/\1/ip' 2>/dev/null)
  if [ -n "$title" ]; then
    if printf '%s\n' "$title" | grep -Eqi 'blocked|заблокирован|доступ ограничен|страница заблокирована'; then
      return 0
    fi
  fi
  local sz
  sz=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
  if [ -n "$sz" ] && [ "$sz" -gt 0 ] && [ "$sz" -lt 16384 ]; then
    if grep -qF "blocked_packages" "$f" 2>/dev/null; then
      return 1
    fi
    if grep -Eqi '(заблокирован|доступ ограничен|страница заблокирована|реестр.*запрещенных|единый реестр|eais\.rkn|eais\.gov\.ru|zapret-info)' "$f" 2>/dev/null; then
      return 0
    fi
  fi
  return 1
}

rand_hex() {
  od -An -N2 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' || echo "$$"
}

probe_attempt() { # <вид> <путь к утилите> <host[/путь]> [proto 1=http, 2=tls1.2, 3=tls1.3, 4=quic] -> "ok <мс>" | "fail <причина>" | "skip <причина>"
  local kind="$1" bin="$2" target="$3" proto="${4:-3}" t0 t1 out rc to=""
  target=$(resolve_probe_target "$target")
  local host="${target%%/*}" path="${target#*/}"
  [ "$host" = "$path" ] && path="" || path="/$path"
  command -v timeout >/dev/null 2>&1 && to="timeout 10"
  t0=$(uptime_cs)
  local tmp_body jar
  # $RANDOM is empty in busybox ash, and $$ is shared by every probe subshell,
  # so the fallback borrows entropy that exists on Android
  tmp_body=$(mktemp "${TMPDIR:-/tmp}/probe_body.XXXXXX" 2>/dev/null || echo "$STATE_DIR/probe_body.$$.$(rand_hex).tmp")
  jar=$(mktemp "$STATE_DIR/probe.ck.XXXXXX" 2>/dev/null || echo "$STATE_DIR/probe.ck.$$.$(rand_hex).tmp")

  case "$proto" in
    1) # Plain HTTP (порт 80)
      local url="http://${host}:80${path:-/}"
      if [ "$kind" = "curl" ]; then
        out=$($to "$bin" -s -L --max-redirs 5 -m 8 --connect-timeout 5 -o "$tmp_body" -A 'Mozilla/5.0' \
          -b "$jar" -c "$jar" -w "\nREDIRECT_URL:%{redirect_url}\nHTTP_CODE:%{http_code}\n" "$url" 2>&1); rc=$?
      else
        out=$($to "$bin" wget -q -T 6 -O "$tmp_body" -U 'Mozilla/5.0' "$url" 2>&1); rc=$?
      fi
      ;;
    2) # TLS 1.2 (порт 443)
      local url="https://${target}"
      if [ "$kind" = "curl" ]; then
        if [ "$host" = "gateway.discord.gg" ]; then
          out=$($to "$bin" -s -k --tlsv1.2 --tls-max 1.2 \
            -H "Upgrade: websocket" -H "Connection: Upgrade" \
            -H "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==" -H "Sec-WebSocket-Version: 13" \
            -L --max-redirs 5 -m 8 --connect-timeout 5 -o "$tmp_body" -A 'Mozilla/5.0' \
            -b "$jar" -c "$jar" -w "\nREDIRECT_URL:%{redirect_url}\nHTTP_CODE:%{http_code}\n" "https://gateway.discord.gg/?v=10&encoding=json" 2>&1); rc=$?
        else
          out=$($to "$bin" -s -k --tlsv1.2 --tls-max 1.2 -L --max-redirs 5 -m 8 --connect-timeout 5 -o "$tmp_body" -A 'Mozilla/5.0' \
            -b "$jar" -c "$jar" -w "\nREDIRECT_URL:%{redirect_url}\nHTTP_CODE:%{http_code}\n" "$url" 2>&1); rc=$?
        fi
      else
        out=$($to "$bin" wget -q -T 6 -O "$tmp_body" -U 'Mozilla/5.0' --no-check-certificate "$url" 2>&1); rc=$?
      fi
      ;;
    3) # TLS 1.3 (порт 443)
      local url="https://${target}"
      if [ "$kind" = "curl" ]; then
        if [ "$host" = "gateway.discord.gg" ]; then
          out=$($to "$bin" -s -k --tlsv1.3 \
            -H "Upgrade: websocket" -H "Connection: Upgrade" \
            -H "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==" -H "Sec-WebSocket-Version: 13" \
            -L --max-redirs 5 -m 8 --connect-timeout 5 -o "$tmp_body" -A 'Mozilla/5.0' \
            -b "$jar" -c "$jar" -w "\nREDIRECT_URL:%{redirect_url}\nHTTP_CODE:%{http_code}\n" "https://gateway.discord.gg/?v=10&encoding=json" 2>&1); rc=$?
        else
          out=$($to "$bin" -s -k --tlsv1.3 -L --max-redirs 5 -m 8 --connect-timeout 5 -o "$tmp_body" -A 'Mozilla/5.0' \
            -b "$jar" -c "$jar" -w "\nREDIRECT_URL:%{redirect_url}\nHTTP_CODE:%{http_code}\n" "$url" 2>&1); rc=$?
        fi
      else
        out=$($to "$bin" wget -q -T 6 -O "$tmp_body" -U 'Mozilla/5.0' --no-check-certificate "$url" 2>&1); rc=$?
      fi
      ;;
    4) # QUIC / HTTP/3 (UDP 443)
      rm -f "$tmp_body" "$jar"
      if grep -qFi "$host" "$LISTS_DIR/quic_unsupported.list" 2>/dev/null; then
        echo "skip quic_unsupported"
        return
      fi
      if [ "$kind" = "curl" ] && "$bin" --help 2>&1 | grep -q '\-\-http3'; then
        out=$($to "$bin" -s -k --http3-only -m 6 --connect-timeout 4 -o /dev/null \
          -A 'Mozilla/5.0' "https://${target}" 2>&1); rc=$?
      else
        echo "skip quic_unsupported"
        return
      fi
      ;;
    *)
      rm -f "$tmp_body" "$jar"
      echo "fail other"
      return
      ;;
  esac

  t1=$(uptime_cs)
  local redir http_code
  redir=$(printf '%s\n' "$out" | sed -n 's/^REDIRECT_URL://p')
  http_code=$(printf '%s\n' "$out" | sed -n 's/^HTTP_CODE://p')
  case "$redir" in
    *rkn.gov.ru*|*eais.*|*warning.rt.ru*|*blackhole*|*zapret*)
      rm -f "$tmp_body" "$jar"
      echo "fail isp_redir"
      return ;;
  esac

  if is_block_notice "$tmp_body"; then
    rm -f "$tmp_body" "$jar"
    echo "fail isp_redir"
    return
  fi

  if [ "$host" = "gateway.discord.gg" ] && [ "$kind" = "curl" ] && [ "$rc" = 0 ]; then
    rm -f "$tmp_body" "$jar"
    if [ "$http_code" = "101" ]; then
      echo "ok $(( (t1 - t0) * 10 ))"
    else
      echo "fail ws_blocked"
    fi
    return
  fi

  rm -f "$tmp_body" "$jar"
  if [ "$rc" = 0 ]; then echo "ok $(( (t1 - t0) * 10 ))"; return; fi
  # Followed maximum redirects (bot cookie protection loop, e.g. Cloudflare / mi.com)
  # Server answered repeatedly over HTTP/TLS, so DPI did not block it: site is reachable
  [ "$kind:$rc" = "curl:47" ] && { echo "ok $(( (t1 - t0) * 10 ))"; return; }
  case "$kind:$rc:$out" in
    wget:*"server returned error"*|curl:22:*) echo "ok $(( (t1 - t0) * 10 ))" ;;
    curl:35:*)
      case "$out" in
        *alert*|*Alert*|*unrecognized_name*|*handshake_failure*) echo "fail tls_alert" ;;
        *wrong\ version*|*record\ overflow*|*illegal\ parameter*) echo "fail tls_spoof" ;;
        *certificate*|*self-signed*|*expired*) echo "fail tls_mitm" ;;
        *) echo "fail tls" ;;
      esac ;;
    curl:52:*|curl:56:*)
      case "$out" in
        *reset*|*Reset*|*connection\ reset*|*broken\ pipe*) echo "fail tls_rst" ;;
        *) echo "fail reset" ;;
      esac ;;
    curl:28:*|*:124:*|*:143:*)
      case "$out" in
        *connect*|*handshake*|*SSL*|*TLS*) echo "fail drop" ;;
        *) echo "fail timeout" ;;
      esac ;;
    curl:6:*|*"bad address"*|*"resolve"*|*"unknown host"*) echo "fail dns_fail" ;;
    curl:7:*|*"refused"*) echo "fail refused" ;;
    *) echo "fail other" ;;
  esac
}

# Повторный запрос по тому же соединению (curl). ТСПУ замораживает часть
# соединений после первого обмена: первый запрос отвечает, следующий по этому
# соединению (так ходят приложения и браузер) висит до тайм-аута.
probe_keepalive() { # <путь к curl> <host[/путь]>
  local bin="$1" url="https://$2" out rc to="" rate="--rate 30/m"
  command -v timeout >/dev/null 2>&1 && to="timeout 25"
  while :; do
    # пауза 2 с между запросами (--rate): приложение тоже спрашивает не сразу
    out=$($to "$bin" -s -k -o /dev/null -o /dev/null $rate -m 8 --connect-timeout 6 -A 'Mozilla/5.0' \
      -w '%{http_code} %{num_connects}\n' "$url" "$url" 2>/dev/null); rc=$?
    # старый curl без --rate — без паузы
    [ "$rc" = 2 ] && [ -n "$rate" ] && { rate=""; continue; }
    break
  done
  printf '%s\n' "$out" | awk 'NR == 1 { first = $1 } NR == 2 { code = $1; nc = $2 } END {
    if (first == "" || first == "000") print "skip"
    else if (code == "000" && nc == "0") print "stall"
    else print "ok" }'
}

cmd_net_info() {
  local ip="" loc="" isp="" asn="" iface="" gw="" dns1="" dns2=""
  local tool kind bin to=""
  tool=$(probe_tool); kind="${tool%% *}"; bin="${tool#* }"
  command -v timeout >/dev/null 2>&1 && to="timeout 6"

  if [ "$kind" = "curl" ]; then
    local trace
    trace=$($to "$bin" -s -m 4 https://cloudflare.com/cdn-cgi/trace 2>/dev/null)
    ip=$(printf '%s\n' "$trace" | sed -n 's/^ip=//p')
    loc=$(printf '%s\n' "$trace" | sed -n 's/^loc=//p')
    local ipapi
    ipapi=$($to "$bin" -s -m 4 "http://ip-api.com/json/?fields=isp,as" 2>/dev/null)
    if [ -n "$ipapi" ]; then
      isp=$(printf '%s\n' "$ipapi" | sed -n 's/.*"isp":"\([^"]*\)".*/\1/p')
      asn=$(printf '%s\n' "$ipapi" | sed -n 's/.*"as":"\([^"]*\)".*/\1/p')
    fi
  fi

  iface=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
  gw=$(ip route show default 2>/dev/null | awk '{print $3; exit}')
  dns1=$(getprop net.dns1 2>/dev/null)
  dns2=$(getprop net.dns2 2>/dev/null)
  [ -z "$dns1" ] && [ -f /etc/resolv.conf ] && dns1=$(awk '/nameserver/{print $2; exit}' /etc/resolv.conf 2>/dev/null)

  local cur_strat
  cur_strat=$(get_current_strategy)

  printf 'NET\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "${ip:-—}" "${loc:-—}" "${isp:-—}" "${asn:-—}" \
    "${iface:-—}" "${gw:-—}" "${dns1:-—}${dns2:+,$dns2}" \
    "$(is_running && echo running || echo stopped)" "${cur_strat:-—}"
}

cmd_probe_all_inner() {
  local kind="$1" bin="$2" target="${3:-}" i=0 h batch=0 probe_hosts_file="$STATE_DIR/probe.hosts.$$"
  rm -f "$probe_hosts_file"
  if [ -n "$target" ]; then
    printf '%s\n' "$(resolve_probe_target "$target")" > "$probe_hosts_file"
  else
    grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$LISTS_DIR/probe_hosts.list" 2>/dev/null | tr -d '\r' | while IFS= read -r h; do
      [ -n "$h" ] && printf '%s\n' "$(resolve_probe_target "$h")" >> "$probe_hosts_file"
    done
  fi
  while IFS= read -r h; do
    [ -z "$h" ] && continue
    printf 'H\t%s\t%s\n' "$i" "$h"
    i=$((i + 1))
  done < "$probe_hosts_file"
  i=0
  while IFS= read -r h; do
    [ -z "$h" ] && continue
    (
      local k=1 r="" r1="" r2="" r3="" r4=""
      while [ "$k" -le 4 ]; do
        r=$(probe_attempt "$kind" "$bin" "$h" "$k")
        printf 'R\t%s\t%s\t%s\n' "$i" "$k" "$r"
        case "$k" in
          1) r1="$r" ;;
          2) r2="$r" ;;
          3) r3="$r" ;;
          4) r4="$r" ;;
        esac
        k=$((k + 1))
      done

      # Дифференциальный отчет TLS 1.2 vs TLS 1.3
      local st2="${r2%% *}" st3="${r3%% *}"
      if [ "$st2" = "ok" ] && [ "$st3" != "ok" ]; then
        printf 'TLS_DIFF\t%s\t%s\ttls13_blocked\tTLS 1.3 заблокирован ТСПУ, TLS 1.2 доступен\n' "$i" "$h"
      elif [ "$st3" = "ok" ] && [ "$st2" != "ok" ]; then
        printf 'TLS_DIFF\t%s\t%s\ttls12_blocked\tTLS 1.2 заблокирован ТСПУ, TLS 1.3 доступен\n' "$i" "$h"
      elif [ "$st2" = "ok" ] && [ "$st3" = "ok" ]; then
        printf 'TLS_DIFF\t%s\t%s\tboth_ok\tОба протокола (TLS 1.2 и 1.3) доступны\n' "$i" "$h"
      elif [ "$st2" != "ok" ] && [ "$st3" != "ok" ]; then
        printf 'TLS_DIFF\t%s\t%s\tboth_blocked\tОба протокола (TLS 1.2 и 1.3) заблокированы\n' "$i" "$h"
      fi

      # QUIC авто-диагностика
      local st4="${r4%% *}"
      if { [ "$st2" = "ok" ] || [ "$st3" = "ok" ]; } && [ "$st4" = "fail" ]; then
        printf 'QUIC_STATUS\t%s\t%s\tblocked\tQUIC (HTTP/3) глушится провайдером, HTTPS доступен\n' "$i" "$h"
      elif [ "$st4" = "ok" ]; then
        printf 'QUIC_STATUS\t%s\t%s\tok\tQUIC (HTTP/3) доступен\n' "$i" "$h"
      fi
    ) &
    batch=$((batch + 1))
    if [ "$batch" -ge 8 ]; then
      wait
      batch=0
    fi
    i=$((i + 1))
  done < "$probe_hosts_file"
  wait
  rm -f "$probe_hosts_file"
}

cmd_tcp16_status() {
  local asns="none" nets=0 snis=0
  if [ -f "$STATE_DIR/tcp16_asn.txt" ]; then
    asns=$(tr '\n' ' ' < "$STATE_DIR/tcp16_asn.txt" 2>/dev/null | sed 's/[[:space:]]*$//')
    [ -z "$asns" ] && asns="none"
  fi
  [ -f "$STATE_DIR/tcp16_nets.txt" ] && nets=$(grep -c '^[0-9]' "$STATE_DIR/tcp16_nets.txt" 2>/dev/null || :)
  [ -n "$nets" ] || nets=0
  [ -f "$STATE_DIR/tcp16_sni.txt" ] && snis=$(grep -c '^[0-9]' "$STATE_DIR/tcp16_sni.txt" 2>/dev/null || :)
  [ -n "$snis" ] || snis=0
  printf '{"asns":"%s","nets":%d,"snis":%d}\n' "$asns" "$nets" "$snis"
}

cmd_probe_tcp16() {
  local tool kind bin to=""
  tool=$(probe_tool); kind="${tool%% *}"; bin="${tool#* }"
  [ "$kind" = "curl" ] || return 0
  command -v timeout >/dev/null 2>&1 && to="timeout 8"

  local targets=""
  if [ -f "$LISTS_DIR/tcp16.list" ]; then
    targets=$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$LISTS_DIR/tcp16.list" 2>/dev/null | tr -d '\r')
  fi
  [ -z "$targets" ] && targets="Hetzner_HE-01|91.98.156.82|443|
Hetzner_Cloud_2_HE-03|5.161.249.234|443|
Cloudflare_CF-01|172.67.70.222|443|
Cloudflare_CF-03|104.18.63.125|443|
CDN77_#1_CDN-02|195.181.167.155|443|
Akamai_1_AK-01|23.222.76.4|443|
AWS_1_AWS-02|3.165.188.250|443|
Contabo_1_CNT-01|173.249.28.198|443|
Fastly_FST-01|151.101.66.245|443|www.jetblue.com
Fastly_GitHub_108_FST-03|185.199.108.133|443|release-assets.githubusercontent.com
Google_Cloud_GC-01|147.189.239.240|443|
Oracle_Cloud_OR-01|153.72.114.110|443|
OVH_OVH-01|5.196.63.68|443|"

  local pad16 pad24 pad32
  pad16=$(printf '%*s' 16384 '' | tr ' ' 'a')
  pad24=$(printf '%*s' 24576 '' | tr ' ' 'b')
  pad32=$(printf '%*s' 32768 '' | tr ' ' 'c')

  local idx=0
  printf '%s\n' "$targets" | while IFS='|' read -r provider ip port sni; do
    [ -z "$provider" ] || [ -z "$ip" ] && continue
    [ -z "$port" ] && port=443
    local proto="https" url
    [ "$port" = "80" ] && proto="http"
    set -- -s -k -o /dev/null
    if [ -n "$sni" ]; then
      set -- "$@" --resolve "$sni:$port:$ip" -H "Host: $sni"
      url="$proto://$sni:$port/"
    else
      url="$proto://$ip:$port/"
    fi

    # Step 1: 0KB probe
    local out0 rc0
    out0=$($to "$bin" "$@" -m 5 --connect-timeout 4 -w "%{time_total}" "$url" 2>&1); rc0=$?
    if [ "$rc0" != 0 ] && [ "$rc0" != 22 ]; then
      printf 'T16\t%s\t%s\t%s\t%s\tunreachable\t%s\n' "$idx" "$provider" "$ip" "$port" "0KB"
      idx=$((idx + 1))
      continue
    fi

    # Steps 2-4: 16KB / 24KB / 32KB probes
    local detected="" sz pad outp rcp
    for sz in 16KB 24KB 32KB; do
      case "$sz" in 16KB) pad="$pad16" ;; 24KB) pad="$pad24" ;; 32KB) pad="$pad32" ;; esac
      outp=$($to "$bin" "$@" -m 6 --connect-timeout 4 -H "X-Pad: $pad" "$url" 2>&1); rcp=$?
      if [ "$rcp" != 0 ] && [ "$rcp" != 22 ]; then
        case "$rcp:$outp" in
          52:*|56:*|28:*|*:*reset*|*:*timed\ out*|*:*EOF*)
            detected="$sz"
            break ;;
        esac
      fi
    done
    if [ -n "$detected" ]; then
      printf 'T16\t%s\t%s\t%s\t%s\tdetected\t%s\n' "$idx" "$provider" "$ip" "$port" "$detected"
      record_tcp16_detection "$provider" "$ip" "$detected"
      idx=$((idx + 1))
      continue
    fi

    local ms
    ms=$(awk -v t="${out0:-0}" 'BEGIN { printf "%d", t * 1000 }' 2>/dev/null || echo 0)
    printf 'T16\t%s\t%s\t%s\t%s\tclean\t%sms\n' "$idx" "$provider" "$ip" "$port" "$ms"
    idx=$((idx + 1))
  done
}

cmd_probe_dns() {
  local tool kind bin to="" ns_cmd="" b
  tool=$(probe_tool); kind="${tool%% *}"; bin="${tool#* }"
  [ "$kind" = "none" ] && return 0
  command -v timeout >/dev/null 2>&1 && to="timeout 6"

  if command -v nslookup >/dev/null 2>&1; then
    ns_cmd="nslookup"
  else
    for b in /data/adb/ksu/bin/busybox /data/adb/ap/bin/busybox /data/adb/magisk/busybox "$(command -v busybox 2>/dev/null)"; do
      [ -n "$b" ] && [ -x "$b" ] && "$b" nslookup --help >/dev/null 2>&1 && { ns_cmd="$b nslookup"; break; }
    done
  fi

  local servers=""
  if [ -f "$LISTS_DIR/probe_dns.list" ]; then
    servers=$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$LISTS_DIR/probe_dns.list" 2>/dev/null | tr -d '\r')
  fi
  [ -z "$servers" ] && servers="Google|8.8.8.8|https://dns.google/dns-query
Cloudflare_IP|1.1.1.1|https://1.1.1.1/dns-query
Quad9|9.9.9.9|https://dns.quad9.net/dns-query
AdGuard|94.140.14.14|https://dns.adguard-dns.com/dns-query
Yandex|77.88.8.8|https://common.dot.dns.yandex.net/dns-query"

  local idx=0
  printf '%s\n' "$servers" | while IFS='|' read -r name ip doh; do
    [ -z "$name" ] || [ -z "$ip" ] && continue
    local udp_status="skip" doh_status="none" hijacked="no" detail="OK"

    if [ -n "$ns_cmd" ]; then
      local ns_out
      ns_out=$($to $ns_cmd vk.ru "$ip" 2>&1)
      if [ $? != 0 ] || printf '%s\n' "$ns_out" | grep -qi -e 'timed out' -e 'no answer' -e 'connection refused'; then
        udp_status="fail"
      else
        udp_status="ok"
      fi

      local ns_chk blocked_ip
      ns_chk=$($to $ns_cmd rutracker.org "$ip" 2>&1)
      blocked_ip=$(printf '%s\n' "$ns_chk" | awk '/^Name:/ {seen=1} seen && /^Address( 1)?: / {ip=$NF} END {print ip}')
      case "$blocked_ip" in
        198.18.*|198.19.*)
          hijacked="yes"; detail="Fake-IP ($blocked_ip)" ;;
        127.0.0.1|0.0.0.0|10.*|192.168.*|195.82.146.214|82.202.164.12)
          hijacked="yes"; detail="Заглушка ($blocked_ip)" ;;
      esac
      case "$name" in
        *MSK-IX*|*НСДИ*) hijacked="no" ;;
      esac
    fi

    if [ -n "$doh" ] && [ "$kind" = "curl" ]; then
      local doh_out rc
      doh_out=$($to "$bin" -s -m 5 -H 'accept: application/dns-json' "$doh?name=vk.ru&type=A" 2>&1); rc=$?
      if [ "$rc" = 0 ] && printf '%s' "$doh_out" | grep -q '"Status"'; then
        doh_status="ok"
      else
        doh_status="fail"
      fi
    elif [ -z "$doh" ] && [ "$kind" = "curl" ]; then
      # DoT проверка (TLS порт 853)
      local dot_out rc_dot
      dot_out=$($to "$bin" -s -k -m 4 --connect-timeout 3 -o /dev/null "https://$ip:853/" 2>&1); rc_dot=$?
      if [ "$rc_dot" = 0 ] || [ "$rc_dot" = 35 ] || [ "$rc_dot" = 52 ] || [ "$rc_dot" = 56 ]; then
        doh_status="ok"
      fi
    fi

    printf 'DNS\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$idx" "$name" "$ip" "$udp_status" "$doh_status" "$hijacked" "$detail"
    idx=$((idx + 1))
  done
}

cmd_probe_tg() {
  local tool kind bin to=""
  tool=$(probe_tool); kind="${tool%% *}"; bin="${tool#* }"
  [ "$kind" = "none" ] && return 0
  command -v timeout >/dev/null 2>&1 && to="timeout 6"

  local dcs=""
  if [ -f "$LISTS_DIR/probe_tg.list" ]; then
    dcs=$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$LISTS_DIR/probe_tg.list" 2>/dev/null | tr -d '\r')
  fi
  [ -z "$dcs" ] && dcs="DC1|149.154.175.53|443
DC2|149.154.167.51|443
DC3|149.154.175.100|443
DC4|149.154.167.91|443
DC5|91.108.56.130|443"

  local idx=0 best_media_dc="DC4" best_media_ip="149.154.167.91" min_latency=99999
  local affinity_tmp="$STATE_DIR/tg_aff.$$.tmp"
  : > "$affinity_tmp"

  printf '%s\n' "$dcs" | while IFS='|' read -r name ip port; do
    [ -z "$name" ] || [ -z "$ip" ] && continue
    [ -z "$port" ] && port=443

    local out rc t_ms="0" status="fail"
    if [ "$kind" = "curl" ]; then
      out=$($to "$bin" -s -k -m 5 --connect-timeout 3 -o /dev/null -w "%{time_connect}" "https://$ip:$port/" 2>&1); rc=$?
      if [ "$rc" = 0 ] || [ "$rc" = 52 ] || [ "$rc" = 56 ] || [ "$rc" = 22 ]; then
        t_ms=$(awk -v t="${out:-0}" 'BEGIN { printf "%d", t * 1000 }' 2>/dev/null || echo 0)
        status="ok"
      fi
    else
      local t0 t1
      t0=$(uptime_cs)
      out=$($to "$bin" wget -q -T 4 -O /dev/null --no-check-certificate "https://$ip:$port/" 2>&1); rc=$?
      t1=$(uptime_cs)
      if [ "$rc" = 0 ] || printf '%s' "$out" | grep -q 'server returned error'; then
        t_ms=$(( (t1 - t0) * 10 ))
        status="ok"
      fi
    fi

    if [ "$status" = "ok" ]; then
      printf 'TG\t%s\t%s\t%s\tok\t%sms\n' "$idx" "$name" "$ip" "$t_ms"
    else
      printf 'TG\t%s\t%s\t%s\tfail\ttimeout\n' "$idx" "$name" "$ip"
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$ip" "$port" "$status" "$t_ms" >> "$affinity_tmp"
    idx=$((idx + 1))
  done

  local af_json="{\n  \"updated_at\": $(date +%s 2>/dev/null || echo 0),\n  \"dcs\": {\n"
  local first=1
  while IFS="$(printf '\t')" read -r d_name d_ip d_port d_status d_latency; do
    [ -z "$d_name" ] && continue
    if [ "$d_name" = "DC4" ] || [ "$d_name" = "DC2" ]; then
      if [ "$d_status" = "ok" ] && [ "${d_latency:-99999}" -lt "$min_latency" ]; then
        min_latency="$d_latency"
        best_media_dc="$d_name"
        best_media_ip="$d_ip"
      fi
    fi
    local is_pm="false"
    [ "$d_name" = "DC4" ] && is_pm="true"
    if [ "$first" = 1 ]; then
      first=0
    else
      af_json="${af_json},\n"
    fi
    af_json="${af_json}    \"$d_name\": {\"ip\": \"$d_ip\", \"port\": $d_port, \"status\": \"$d_status\", \"latency_ms\": $d_latency, \"primary_media\": $is_pm}"
  done < "$affinity_tmp"
  rm -f "$affinity_tmp"

  local media_spd="N/A"
  if [ "$kind" = "curl" ]; then
    local spd
    spd=$($to "$bin" -s -k -m 8 -o /dev/null -r 0-262144 -w "%{speed_download}" "https://telegram.org/img/Telegram200million.png" 2>/dev/null)
    media_spd=$(awk -v s="${spd:-0}" 'BEGIN { printf "%.2f", s / 1048576 }' 2>/dev/null || echo 0)
    printf 'TG_MEDIA\tok\t%s MB/s\n' "$media_spd"
  else
    printf 'TG_MEDIA\tskip\tN/A\n'
  fi

  af_json="${af_json}\n  },\n  \"primary_media_dc\": \"$best_media_dc\",\n  \"media_speed_mbps\": \"$media_spd\"\n}\n"
  mkdir -p "$STATE_DIR" 2>/dev/null
  printf '%b' "$af_json" > "$TG_AFFINITY_FILE" 2>/dev/null
  printf 'TG_AFFINITY\t%s\t%s\tprimary_media\t%sms\n' "$best_media_dc" "$best_media_ip" "$min_latency"
}

kill_descendants() { # <pid> — curl живёт под под-shell пробы, то есть внуком
  local p="$1" stat cpid comm st ppid rest
  for stat in /proc/[0-9]*/stat; do
    [ -r "$stat" ] || continue
    read -r cpid comm st ppid rest < "$stat" 2>/dev/null || continue
    [ "$ppid" = "$p" ] && kill_descendants "$cpid"
  done
  kill -TERM "$p" 2>/dev/null || true
}

cmd_probe_cancel() {
  if [ -f "$STATE_DIR/probe.pid" ]; then
    local p
    p=$(cat "$STATE_DIR/probe.pid" 2>/dev/null)
    if [ -n "$p" ]; then
      pkill -TERM -P "$p" 2>/dev/null || true
      kill_descendants "$p"
    fi
    rm -f "$STATE_DIR/probe.pid"
  fi
  cleanup_probe_app_rule
  echo OK
}

cmd_check_domain() {
  local raw="$1" d
  d=$(printf '%s' "$raw" | tr 'A-Z' 'a-z' | sed 's#^[a-z]*://##; s#/.*##; s/:[0-9]*$//; s/^www\.//')
  case "$d" in
    ''|*[!a-z0-9.-]*)
      echo "INVALID"
      return 1
      ;;
  esac

  local found_lists=""
  local list_name f d_esc
  d_esc=$(printf '%s' "$d" | sed 's/\./\\./g')
  for list_name in user exclude auto probe_bench probe_hosts; do
    f="$LISTS_DIR/$list_name.list"
    [ -f "$f" ] || continue

    if tr -d '\r' < "$f" 2>/dev/null | grep -Eq "^(www\.)?$d_esc$"; then
      found_lists="$found_lists${found_lists:+,}$list_name"
      continue
    fi

    local parent="$d"
    while case "$parent" in *.*) true ;; *) false ;; esac; do
      parent="${parent#*.}"
      case "$parent" in
        *.*)
          local p_esc
          p_esc=$(printf '%s' "$parent" | sed 's/\./\\./g')
          if tr -d '\r' < "$f" 2>/dev/null | grep -Eq "^(www\.)?$p_esc$"; then
            found_lists="$found_lists${found_lists:+,}$list_name"
            break
          fi
          ;;
      esac
    done
  done

  if [ -n "$found_lists" ]; then
    printf 'FOUND\t%s\t%s\n' "$d" "$found_lists"
  else
    printf 'NOT_FOUND\t%s\n' "$d"
  fi
}

# ---------------------------------------------------------------- поделиться файлом
# Файлом — ссылкой file:// на настоящий путь: root-проводник (MT Manager и
# др.) откроет его на месте; текстом — содержимое в EXTRA_TEXT, для чатов.
# Только файлы модуля: конфиг и файлы hosts/стратегий.
share_file_ok() {
  case "$1" in
    */../*) return 1 ;;   # «*» в шаблоне пропускает и «/» с «..»
    "$CONFFILE") ;;
    "$CONFDIR"/hosts/*.txt) case "${1#"$CONFDIR"/hosts/}" in */*) return 1 ;; esac ;;
    # файлы стратегий — «Поделиться» из меню стратегии (путь даёт strategy-path)
    "$MODDIR/defaults/nfqws2.conf") ;;
    "$STRATEGIES_DIR"/*.conf) case "${1#"$STRATEGIES_DIR"/}" in */*) return 1 ;; esac ;;
    "$USER_STRATEGIES_DIR"/*.conf) case "${1#"$USER_STRATEGIES_DIR"/}" in */*) return 1 ;; esac ;;
    "$IMPORTS_DIR"/*.conf) case "${1#"$IMPORTS_DIR"/}" in */*) return 1 ;; esac ;;
    *) return 1 ;;
  esac
  [ -f "$1" ]
}
cmd_share() { # <file|text> <путь>
  share_file_ok "$2" || { echo "Этим файлом делиться нельзя" >&2; return 1; }
  local out
  if [ "$1" = text ]; then
    [ "$(wc -c < "$2")" -lt 90000 ] || { echo "Файл слишком большой, чтобы отправить текстом" >&2; return 1; }
    out=$(am start -a android.intent.action.SEND -t text/plain --es android.intent.extra.SUBJECT "${2##*/}" \
      --es android.intent.extra.TEXT "$(cat "$2")" 2>&1)
  else
    out=$(am start -a android.intent.action.SEND -t text/plain --es android.intent.extra.SUBJECT "${2##*/}" \
      --eu android.intent.extra.STREAM "file://$2" --grant-read-uri-permission 2>&1)
  fi
  case "$out" in *Error*|*Exception*) echo "Не удалось открыть «Поделиться»: $out" >&2; return 1 ;; esac
  echo OK
}

domain_norm() {
  printf '%s' "$1" | tr 'A-Z' 'a-z' | sed 's#^[a-z]*://##; s#[/?:].*##; s/^\*\.//; s/^\.//; s/\.$//'
}
ip_in_ipsets() { # <ip> <файл>... -> файлы, где есть подсеть с этим IP (IPv4)
  local ip="$1"; shift
  awk -v ip="$ip" '
    function n(a,   p) { split(a, p, "."); return ((p[1] * 256 + p[2]) * 256 + p[3]) * 256 + p[4] }
    BEGIN { x = n(ip) }
    FNR == 1 { found = 0 }
    found || /^[ \t]*(#|$)/ || index($0, ":") { next }
    {
      sub(/[ \t\r].*$/, ""); net = $0; bits = 32
      if ((k = index(net, "/"))) { bits = substr(net, k + 1) + 0; net = substr(net, 1, k - 1) }
      if (net !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) next
      size = 2 ^ (32 - bits); lo = int(n(net) / size) * size
      if (x >= lo && x < lo + size) { found = 1; print FILENAME "\t" $0 }
    }' "$@" 2>/dev/null
}
cmd_domain_check() {
  local d cand f role used args entry tool kind bin ip="" k
  d=$(domain_norm "$1")
  case "$d" in ''|*[!a-z0-9.-]*|*..*) echo "Некорректный домен" >&2; return 1 ;; esac
  # домен и все родительские: a.b.c -> a.b.c, b.c, c
  cand="$STATE_DIR/domain.cand.$$"; mkdir -p "$STATE_DIR"
  trap 'rm -f "$cand"' EXIT INT TERM
  k="$d"; : > "$cand"
  while :; do printf '%s\n' "$k" >> "$cand"; case "$k" in *.*) k=${k#*.} ;; *) break ;; esac; done

  printf 'MODE\t%s\n' "$(current_mode 2>/dev/null || echo custom)"
  args=$(_startup_args 2>/dev/null)
  used=$(printf '%s\n' "$args" | tr ' ' '\n' | awk -F= '
    $1 ~ /^--(hostlist|hostlist-exclude|hostlist-auto|ipset|ipset-exclude)$/ { print substr($1, 3), substr($0, length($1) + 2) }')

  # Списки доменов: подключённые к запуску и остальные (idle)
  for f in "$LISTS_DIR"/*.list; do
    [ -f "$f" ] || continue
    case "${f##*/}" in ipset*|probe_*|apps.list|tcp16.list) continue ;; esac
    # «^домен» (как в списках nfqws-menu) — только сам домен, без поддоменов
    entry=$(tr -d '\r' < "$f" | awk -v d="$d" '
      NR == FNR { c[$0] = 1; next }
      /^\^/ { e = substr($0, 2); if (e == d && length(e) > best) { best = length(e); hit = $0 }; next }
      { e = $0; sub(/^[*.]*/, "", e); if ((e in c) && length(e) > best) { best = length(e); hit = e } }
      END { if (hit != "") print hit }' "$cand" - 2>/dev/null)
    [ -n "$entry" ] || continue
    # exclude.list подключён и пустым профилем исключений (--hostlist) — это
    # всё равно исключение
    role=$(printf '%s\n' "$used" | awk -v f="$f" -v x="$LISTS_DIR/exclude.list" '$2 == f { r = (f == x && $1 == "hostlist") ? "hostlist-exclude" : (r == "hostlist-exclude" ? r : $1) } END {
      if (r == "hostlist") print "host"; else if (r == "hostlist-exclude") print "exclude"; else if (r == "hostlist-auto") print "auto"; else print "idle" }')
    printf 'LIST\t%s\t%s\t%s\n' "${f##*/}" "$role" "$entry"
  done
  rm -f "$cand"

  tool=$(probe_tool); kind="${tool%% *}"; bin="${tool#* }"
  # IP — как его видит система (резолвер Android, с DNS модуля, если он включён)
  ip=$(ping -c 1 -W 2 "$d" 2>/dev/null | sed -n '1s/^PING [^(]*(\([0-9.]*\)).*/\1/p')
  if [ -n "$ip" ]; then
    printf 'IP\t%s\n' "$ip"
    ip_in_ipsets "$ip" "$LISTS_DIR"/ipset*.list | while IFS='	' read -r f entry; do
      role=$(printf '%s\n' "$used" | awk -v f="$f" -v x="$LISTS_DIR/ipset_exclude.list" '$2 == f { r = (f == x && $1 == "ipset") ? "ipset-exclude" : (r == "ipset-exclude" ? r : $1) } END {
        if (r == "ipset") print "ipset"; else if (r == "ipset-exclude") print "ipset-exclude"; else print "idle" }')
      printf 'LIST\t%s\t%s\t%s\n' "${f##*/}" "$role" "$entry"
    done
  fi

  [ "$kind" = none ] && { echo done; return 0; }
  setup_probe_app_rule
  trap 'cleanup_probe_app_rule' EXIT
  trap 'exit 143' INT TERM
  for k in 1 2 3; do ( printf 'R\t%s\t%s\n' "$k" "$(probe_attempt "$kind" "$bin" "$d")" ) & done
  wait
  # WebSocket Discord — не запрос-ответ, повторять нечего
  [ "$kind" = curl ] && [ "$d" != "gateway.discord.gg" ] && printf 'K\t%s\n' "$(probe_keepalive "$bin" "$d")"
  cleanup_probe_app_rule
  echo done
}

# ---------------------------------------------------------------- умный режим
# Выученное — в $SMART_DIR/<сеть>.tsv (пишет lua/zapret-smart.lua), подписи
# сетей — в nets.tsv, имена вариантов — в шапке strategies/smart.conf (#@slot N имя)
smart_valid_net() { case "$1" in ''|*[!a-z0-9-]*) return 1 ;; esac; return 0; }
# Файл сети (формат v4, как v3): slot host cur ok err cool seen flags; ok и err —
# «вариант:вес» через запятую, вес события со временем убывает; flags «e» —
# сайт хоть раз открылся. v2 — то же без flags
cmd_smart_status() { # [сеть — чью статистику показать; без неё — текущей]
  local act=0 net off=0 view
  smart_active && act=1
  net=$(cat "$SMART_NET_FILE" 2>/dev/null)
  [ "$net" = offline ] && off=1
  view="$net"
  smart_valid_net "$1" && view="$1"
  # paused — служба на паузе (дом, VPN, белые списки): обучение ждёт её
  printf '{"active":%s,"running":%s,"paused":%s,"net":"%s","view":"%s","offline":%s,"learn":%s,' \
    "$act" "$(is_running && echo 1 || echo 0)" "$([ -f "$HOME_PAUSED_FILE" ] && echo 1 || echo 0)" "$(json_str "$net")" "$(json_str "$view")" "$off" "${SMART_LEARN:-1}"
  # фоновое обучение: сколько сайтов открыто и какой последний
  printf '"bg":{'
  [ -f "$SMART_LEARN_FILE" ] && awk -F= 'NF >= 2 { k = $1; sub(/^[^=]*=/, ""); gsub(/["\\]/, "", k); gsub(/["\\]/, ""); printf "%s\"%s\":\"%s\"", (n++ ? "," : ""), k, $0 }' "$SMART_LEARN_FILE"
  printf '},"nets":['
  # сети: подпись, сколько сайтов выучено (есть удачи), удачи и ошибки в сумме
  local first=1 id label f
  if [ -f "$SMART_DIR/nets.tsv" ]; then
    while IFS='	' read -r id label; do
      smart_valid_net "$id" || continue
      f="$SMART_DIR/$id.tsv"
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"id":"%s","label":"%s",%s,"current":%s}' "$id" "$(json_str "$label")" \
        "$( { [ -f "$f" ] && head -n 1 "$f" | grep -q '^#v[234]' && cat "$f"; } | awk -F'\t' '
          function sum(s,   a, k, i, p, r) { r = 0; k = split(s, a, ","); for (i = 1; i <= k; i++) { split(a[i], p, ":"); r += p[2] } return r }
          !/^#/ { o = sum($4); e = sum($5); if (o >= 0.5) n++; ok += o; err += e }
          END { printf "\"sites\":%d,\"ok\":%d,\"err\":%d", n, ok + 0.5, err + 0.5 }')" \
        "$([ "$id" = "$net" ] && echo 1 || echo 0)"
    done < "$SMART_DIR/nets.tsv"
  fi
  printf '],'
  # варианты сети (удачи, ошибки, сколько сайтов на варианте) и сайты, у
  # которых на текущем варианте ошибок больше, чем удач
  f="$SMART_DIR/$view.tsv"
  if smart_valid_net "$view" && [ -f "$f" ] && head -n 1 "$f" | grep -q '^#v[234]'; then
    # до v4 «не похоже на блокировку» ставилось по ложным ошибкам — не показываем
    local v3=0
    head -n 1 "$f" | grep -q '^#v4' && v3=1
    sed -n 's/^#@\([a-z]*\) \([0-9]*\) \(.*\)$/N\t\1\t\2\t\3/p' "$STRATEGIES_DIR/smart.conf" 2>/dev/null |
      cat - "$f" | awk -F'\t' -v now="$(date +%s)" -v v3="$v3" '
        function get(s, v,   a, k, i, p) { k = split(s, a, ","); for (i = 1; i <= k; i++) { split(a[i], p, ":"); if (p[1] == v) return p[2] } return 0 }
        function add(s, arr, slot,   a, k, i, p) { k = split(s, a, ","); for (i = 1; i <= k; i++) { split(a[i], p, ":"); arr[slot "|" p[1]] += p[2]; seen[slot "|" p[1]] = 1 } }
        function q(s) { gsub(/["\\]/, "", s); return s }
        # имя варианта: tls_cf, tls_16… берут имена у tls; подстройка — имя
        # основы и что в ней изменено
        function bname(slot, v,   b) {
          if ((slot "|" v) in name) return name[slot "|" v]
          b = slot; sub(/_.*/, "", b)
          return name[b "|" v]
        }
        function nm(slot, v,   c) {
          if (!((slot "|" v) in mb)) return bname(slot, v)
          c = mc[slot "|" v]; gsub(/[0-9]+\./, "", c); gsub(/;/, ", ", c)
          return bname(slot, mb[slot "|" v]) " · подстройка: " c
        }
        $1 == "N" { name[$2 "|" $3] = $4; next }
        $1 == "#m" { mb[$2 "|" $3] = $4; mc[$2 "|" $3] = $5; next }
        /^#/ { next }
        function sum(s,   a, k, i, p, r) { r = 0; k = split(s, a, ","); for (i = 1; i <= k; i++) { split(a[i], p, ":"); r += p[2] } return r }
        {
          add($4, ok, $1); add($5, err, $1)
          sites[$1 "|" $3]++; seen[$1 "|" $3] = 1; slots[$1] = 1
          o = get($4, $3); e = get($5, $3)
          # точность — без сайтов «не похоже на блокировку»: там не DPI
          if (!(v3 && get($6, 0) + 0 > now + 0)) { aok += sum($4); aerr += sum($5) }
          # «0:время» в столбце остывания — не похоже на блокировку: умный режим
          # такой сайт не трогает, и в «сайты с ошибками» он не идёт
          if (v3 && get($6, 0) + 0 > now + 0) { nq++; qh[nq] = $2 }
          else if (e >= 1 && e > o) { np++; ph[np] = $2; ps[np] = $1; pv[np] = $3; po[np] = o; pe[np] = e }
        }
        END {
          printf "\"top\":{"
          ns = 0
          for (s in slots) {
            printf "%s\"%s\":[", (ns++ ? "," : ""), s
            nv = 0
            for (key in seen) {
              split(key, z, "|"); if (z[1] != s) continue
              printf "%s{\"n\":%d,\"name\":\"%s\",\"ok\":%d,\"err\":%d,\"sites\":%d}", (nv++ ? "," : ""), z[2], q(nm(s, z[2])), ok[key] + 0.5, err[key] + 0.5, sites[key] + 0
            }
            printf "]"
          }
          printf "},\"problems\":["
          for (i = 1; i <= np && i <= 30; i++)
            printf "%s{\"host\":\"%s\",\"slot\":\"%s\",\"n\":%d,\"name\":\"%s\",\"ok\":%d,\"err\":%d}", (i > 1 ? "," : ""), q(ph[i]), ps[i], pv[i], q(nm(ps[i], pv[i])), po[i] + 0.5, pe[i] + 0.5
          printf "],\"nodpi\":["
          for (i = 1; i <= nq && i <= 30; i++) printf "%s\"%s\"", (i > 1 ? "," : ""), q(qh[i])
          printf "],\"acc\":{\"ok\":%d,\"err\":%d}", aok + 0.5, aerr + 0.5
        }'
  else
    printf '"top":{},"problems":[],"nodpi":[],"acc":{"ok":0,"err":0}'
  fi
  printf '}\n'
}
# Забыть выученное: одной сети или всего. В памяти nfqws2 оно тоже есть —
# служба перезапускается, иначе записала бы его обратно
cmd_smart_reset() {
  case "$1" in
    all) rm -f "$SMART_DIR"/*.tsv ;;
    *) smart_valid_net "$1" || { echo "Неверная сеть" >&2; exit 1; }
       rm -f "$SMART_DIR/$1.tsv"
       [ -f "$SMART_DIR/nets.tsv" ] && { grep -v "^$1	" "$SMART_DIR/nets.tsv" > "$SMART_DIR/nets.tsv.tmp"; mv -f "$SMART_DIR/nets.tsv.tmp" "$SMART_DIR/nets.tsv"; } ;;
  esac
  if is_running && smart_active; then sh "$SERVICE" restart >/dev/null 2>&1; fi
  smart_net_update
  echo OK
}
# Сайты сети для экрана умного режима: <сеть> <tls|google|quic|problems|nodpi|all>
# -> JSON-массив {host, slot, n, name, ok, err, e} — по удачам, до 300
cmd_smart_sites() {
  local f="$SMART_DIR/$1.tsv" grp="${2:-all}"
  smart_valid_net "$1" || { echo "Неверная сеть" >&2; return 1; }
  case "$grp" in tls|google|quic|problems|nodpi|all) ;; *) echo "tls|google|quic|problems|nodpi|all" >&2; return 1 ;; esac
  if ! { [ -f "$f" ] && head -n 1 "$f" | grep -q '^#v4'; }; then echo '[]'; return 0; fi
  sed -n 's/^#@\([a-z_]*\) \([0-9]*\) \(.*\)$/N\t\1\t\2\t\3/p' "$STRATEGIES_DIR/smart.conf" 2>/dev/null |
    cat - "$f" | awk -F'\t' -v now="$(date +%s)" -v grp="$grp" '
      function get(s, v,   a, k, i, p) { k = split(s, a, ","); for (i = 1; i <= k; i++) { split(a[i], p, ":"); if (p[1] == v) return p[2] } return 0 }
      function q(s) { gsub(/["\\]/, "", s); return s }
      function bname(slot, v,   b) { if ((slot "|" v) in name) return name[slot "|" v]; b = slot; sub(/_.*/, "", b); return name[b "|" v] }
      function nm(slot, v,   c) {
        if (!((slot "|" v) in mb)) return bname(slot, v)
        c = mc[slot "|" v]; gsub(/[0-9]+\./, "", c); gsub(/;/, ", ", c)
        return bname(slot, mb[slot "|" v]) " · подстройка: " c
      }
      $1 == "N" { name[$2 "|" $3] = $4; next }
      $1 == "#m" { mb[$2 "|" $3] = $4; mc[$2 "|" $3] = $5; next }
      /^#/ { next }
      {
        b = $1; sub(/_.*/, "", b)
        o = get($4, $3); e = get($5, $3); nd = get($6, 0) + 0 > now + 0
        if (grp == "nodpi") { if (!nd) next }
        else if (nd) next
        else if (grp == "problems") { if (!(e >= 1 && e > o)) next }
        else if (grp != "all" && b != grp) next
        printf "%.3f\t{\"host\":\"%s\",\"slot\":\"%s\",\"n\":%d,\"name\":\"%s\",\"ok\":%d,\"err\":%d,\"e\":%d}\n", \
          (grp == "problems" ? e : o), q($2), $1, $3, q(nm($1, $3)), o + 0.5, e + 0.5, ($8 == "e")
      }' | sort -t "$(printf '\t')" -k1,1nr | head -n 300 | cut -f2- | awk 'BEGIN { printf "[" } { printf "%s%s", (NR > 1 ? "," : ""), $0 } END { print "]" }'
}
# Поделиться обучением: файл выученного в сети -> «имя<TAB>путь<TAB>[base64]»
cmd_smart_export() { # <сеть> [path]
  local f="$SMART_DIR/$1.tsv" name out
  smart_valid_net "$1" && [ -f "$f" ] || { echo "$(M 'В этой сети ещё ничего не выучено' 'Nothing learned on this network yet')" >&2; return 1; }
  mkdir -p "$BACKUP_DIR" 2>/dev/null || { echo "Нет доступа к $BACKUP_DIR" >&2; return 1; }
  name="nfqws2-smart-$1-$(date '+%Y%m%d-%H%M%S').tsv"; out="$BACKUP_DIR/$name"
  cp -f "$f" "$out" || return 1
  printf '%s\t%s\t' "$name" "$out"
  [ "$2" = path ] || b64e < "$out" | tr -d '\n'
  echo
}
# Чужое обучение — в текущую сеть: сайты, которых здесь ещё нет, с их
# подстройками (номера подстроек — свои, совпадающие не дублируются). Своё
# выученное важнее: сайты, что уже есть, не трогаются. Остывание и «не похоже
# на блокировку» чужой сети не переносятся
cmd_smart_import_b64() { # <base64 файла> -> число добавленных сайтов
  local net f tmp src n
  net=$(cat "$SMART_NET_FILE" 2>/dev/null)
  smart_valid_net "$net" || { echo "$(M 'Сеть ещё не определена — подключитесь к сети' 'The network is not known yet — connect first')" >&2; return 1; }
  mkdir -p "$SMART_DIR" "$STATE_DIR" || return 1
  src="$STATE_DIR/smart_import.$$"; f="$SMART_DIR/$net.tsv"; tmp="$f.imp.$$"
  b64d "$1" | tr -d '\r' > "$src"
  case "$(head -n 1 "$src")" in
    '#v4'*) ;;
    '#v2'*|'#v3'*)
      # старые форматы: колонки те же, но метки «не похоже на блокировку»
      # (cool 0:*) ставились по ложным ошибкам — при миграции отбрасываем
      { printf '#v4 slot\thost\tcur\tok\terr\tcool\tseen\tflags\n'
        sed '1d' "$src" | awk -F'\t' -v OFS='\t' '{
          if ($6 != "") {
            n = split($6, a, ","); o = ""
            for (i = 1; i <= n; i++) if (a[i] !~ /^0:/) o = o (o == "" ? "" : ",") a[i]
            $6 = o
          }
          print }'; } > "$src.mig" && mv -f "$src.mig" "$src" ||
        { rm -f "$src" "$src.mig"; return 1; }
      ;;
    *) rm -f "$src"; echo "$(M 'Это не файл обучения умного режима' 'Not a smart mode learning file')" >&2; return 1 ;;
  esac
  { [ -f "$f" ] && head -n 1 "$f" | grep -q '^#v4'; } || printf '#v4 slot\thost\tcur\tok\terr\tcool\tseen\tflags\n' > "$f"
  awk -F'\t' -v OFS='\t' -v cnt="$tmp.n" '
    function ids(slot, s,   a, k, i, p) { k = split(s, a, ","); for (i = 1; i <= k; i++) { split(a[i], p, ":"); if (p[1] + 0 > mx[slot]) mx[slot] = p[1] + 0 } }
    function rid(slot, v) { if (v + 0 <= 100) return v; return ((slot "|" v) in map) ? map[slot "|" v] : "" }
    function remap(slot, s,   a, k, i, p, out, x) {
      k = split(s, a, ","); out = ""
      for (i = 1; i <= k; i++) { split(a[i], p, ":"); x = rid(slot, p[1]); if (x != "") out = out (out == "" ? "" : ",") x ":" p[2] }
      return out
    }
    FNR == 1 { file++; if (file == 1) print; next }
    file == 1 {
      print
      if ($1 == "#m") { mk[$2 "|" $4 "|" $5] = $3; if ($3 + 0 > mx[$2]) mx[$2] = $3 + 0 }
      else if ($0 !~ /^#/) { have[$1 "|" $2] = 1; if ($3 + 0 > mx[$1]) mx[$1] = $3 + 0; ids($1, $4); ids($1, $5) }
      next
    }
    $1 == "#m" {
      k = $2 "|" $4 "|" $5
      if (!(k in mk)) {
        if (mx[$2] < 100) mx[$2] = 100
        mk[k] = ++mx[$2]
        print "#m", $2, mk[k], $4, $5, $6
      }
      map[$2 "|" $3] = mk[k]
      next
    }
    /^#/ || NF < 7 { next }
    !(($1 "|" $2) in have) {
      have[$1 "|" $2] = 1
      c = rid($1, $3); if (c == "") c = 1
      print $1, $2, c, remap($1, $4), remap($1, $5), "", $7, $8
      n++
    }
    END { print n + 0 > cnt }
  ' "$f" "$src" > "$tmp" && mv -f "$tmp" "$f"
  n=$(cat "$tmp.n" 2>/dev/null); rm -f "$src" "$tmp" "$tmp.n"
  # в памяти nfqws2 своё выученное — служба перезапускается, иначе записала бы его поверх
  if is_running && smart_active; then sh "$SERVICE" restart >/dev/null 2>&1; fi
  echo "${n:-0}"
}
# Фоновое обучение: один случайный сайт — из своего списка, «Проверки
# доступности», обучения и сайтов пользователя. Зовёт помощник умного режима
# (service.sh smartkill) раз в SMART_LEARN_EVERY секунд
cmd_smart_learn_once() {
  local tool kind bin h r n=0 ok=0
  [ "$(cat "$SMART_NET_FILE" 2>/dev/null)" = offline ] && return 0
  tool=$(probe_tool); kind="${tool%% *}"; bin="${tool#* }"
  [ "$kind" = none ] && return 0
  h=$({ grep -hv -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$MODDIR/defaults/smart-learn.list" \
        "$LISTS_DIR/probe_hosts.list" "$LISTS_DIR/user.list" "$LISTS_DIR/auto.list" 2>/dev/null; } |
      tr -d '\r' | awk '$1 !~ /[*^$]/ && $1 ~ /\./ && !seen[$1]++ { print $1 }' |
      awk -v seed="$$$(date +%s)" 'BEGIN { srand(seed % 2147483647) } { a[NR] = $1 } END { if (NR) print a[int(rand() * NR) + 1] }')
  [ -n "$h" ] || return 0
  [ -f "$SMART_LEARN_FILE" ] && { n=$(sed -n 's/^n=//p' "$SMART_LEARN_FILE"); ok=$(sed -n 's/^ok=//p' "$SMART_LEARN_FILE"); }
  setup_probe_app_rule
  trap 'cleanup_probe_app_rule' EXIT
  trap 'trap - EXIT; cleanup_probe_app_rule; exit 130' INT TERM
  r=$(probe_attempt "$kind" "$bin" "$h" </dev/null)
  trap - EXIT INT TERM
  cleanup_probe_app_rule
  n=$((${n:-0} + 1)); case "$r" in ok*) ok=$((${ok:-0} + 1)) ;; esac
  printf 'n=%s\nok=%s\nlast=%s\nt=%s\n' "$n" "${ok:-0}" "$h" "$(date +%s)" > "$SMART_LEARN_FILE.tmp" && mv -f "$SMART_LEARN_FILE.tmp" "$SMART_LEARN_FILE"
}

cmd_bench_strategies() {
  local target_domain="$1"
  local tool kind bin orig_strat orig_running=false
  tool=$(probe_tool); kind="${tool%% *}"; bin="${tool#* }"
  printf 'tool\t%s\n' "$kind"
  [ "$kind" = "none" ] && { echo done; return 0; }
  mkdir -p "$STATE_DIR"
  echo "$$" > "$STATE_DIR/probe.pid"

  orig_strat=$(get_current_strategy)
  if is_running; then orig_running=true; fi
  cp -f "$CONFFILE" "$STATE_DIR/bench_orig.$$.conf" 2>/dev/null

  bench_cleanup() {
    rm -f "$STATE_DIR/probe.pid" "$STATE_DIR/probe_bench_default.$$.list" "$STATE_DIR/probe_bench_custom.$$.list" "$STATE_DIR/bench_res.$$.tmp" "$STATE_DIR/strat_bench.$$.tmp"
    cleanup_probe_app_rule
    if [ -f "$STATE_DIR/bench_orig.$$.conf" ]; then
      cp -f "$STATE_DIR/bench_orig.$$.conf" "$CONFFILE" 2>/dev/null
      rm -f "$STATE_DIR/bench_orig.$$.conf"
      echo "$orig_strat" > "$ACTIVE_FILE" 2>/dev/null
      if [ "$orig_running" = "true" ]; then
        sh "$SERVICE" restart >/dev/null 2>&1
      else
        sh "$SERVICE" stop >/dev/null 2>&1
      fi
    fi
  }
  trap 'trap - EXIT; bench_cleanup; exit 130' INT TERM
  trap 'bench_cleanup' EXIT

  local bench_hosts_file="$LISTS_DIR/probe_bench.list"
  if [ -n "$target_domain" ]; then
    target_domain=$(printf '%s' "$target_domain" | tr 'A-Z' 'a-z' | sed 's#^[a-z]*://##; s#/.*##; s/:[0-9]*$//; s/^www\.//')
    case "$target_domain" in ''|*[!a-z0-9.-]*) echo "Некорректный домен" >&2; return 1 ;; esac
    target_domain=$(resolve_probe_target "$target_domain")
    bench_hosts_file="$STATE_DIR/probe_bench_custom.$$.list"
    printf '%s\n' "$target_domain" > "$bench_hosts_file"
  elif [ ! -f "$bench_hosts_file" ] || [ ! -s "$bench_hosts_file" ]; then
    bench_hosts_file="$STATE_DIR/probe_bench_default.$$.list"
    local gv_def
    gv_def=$(resolve_probe_target "googlevideo.com")
    printf '%s\n' \
      www.youtube.com "$gv_def" discord.com gateway.discord.gg \
      x.com instagram.com rutracker.org meduza.io www.torproject.org cloudflare.com \
      > "$bench_hosts_file"
  fi

  local strats
  strats=$(list_strategies 2>/dev/null | cut -f1 | tr -d '\r' | grep -v '^default$' || true)
  strats="default $strats"

  local best_name="" best_ok=0 best_total=0 best_ms=99999
  local best_yt="" best_yt_ok=0 best_yt_ms=99999
  local best_dc="" best_dc_ok=0 best_dc_ms=99999
  local strat_idx=0 total_strats
  total_strats=$(printf '%s\n' $strats | wc -w | tr -d ' ')

  printf 'BENCH_START\t%s\n' "$total_strats"

  for st in $strats; do
    [ -z "$st" ] && continue
    printf 'BENCH_RUN\t%s\t%s\t%s\n' "$strat_idx" "$st" "$total_strats"

    local patched="$STATE_DIR/strat_bench.$$.tmp"
    if build_strategy_conf "$st" "$patched"; then
      sed 's/^NFQWS_EXTRA_ARGS=.*/NFQWS_EXTRA_ARGS="$MODE_ALL"/' "$patched" > "$CONFFILE" 2>/dev/null
      rm -f "$patched"
      echo "$st" > "$ACTIVE_FILE" 2>/dev/null
    else
      rm -f "$patched"
      printf 'BENCH_RES\t%s\t%s\t0\t0\t0\tfailed_start\t0\t0\n' "$strat_idx" "$st"
      strat_idx=$((strat_idx + 1))
      continue
    fi

    sh "$SERVICE" restart >/dev/null 2>&1

    local ready=false wait_i=0
    while [ "$wait_i" -lt 8 ]; do
      if is_running; then ready=true; break; fi
      sleep 0.3 2>/dev/null || sleep 1
      wait_i=$((wait_i + 1))
    done

    if [ "$ready" != "true" ]; then
      printf 'BENCH_RES\t%s\t%s\t0\t0\t0\tfailed_start\t0\t0\n' "$strat_idx" "$st"
      strat_idx=$((strat_idx + 1))
      continue
    fi

    setup_probe_app_rule

    # Tier 1 Screening: fast screening on YouTube and Discord
    if [ -z "$target_domain" ]; then
      local t1_res="$STATE_DIR/t1_res.$$.tmp"
      ( printf 'yt\t%s\n' "$(probe_attempt "$kind" "$bin" "redirector.googlevideo.com" 3)" ) > "$t1_res" &
      ( printf 'dc\t%s\n' "$(probe_attempt "$kind" "$bin" "gateway.discord.gg" 3)" ) >> "$t1_res" &
      wait
      local r_yt r_dc yt_st dc_st
      r_yt=$(grep '^yt	' "$t1_res" 2>/dev/null | cut -f2-)
      r_dc=$(grep '^dc	' "$t1_res" 2>/dev/null | cut -f2-)
      rm -f "$t1_res"
      yt_st="${r_yt%% *}"
      dc_st="${r_dc%% *}"
      if [ "$yt_st" != "ok" ] && [ "$dc_st" != "ok" ]; then
        local f_reason="${r_yt#* }"
        [ -z "$f_reason" ] && f_reason="${r_dc#* }"
        [ -z "$f_reason" ] && f_reason="screen_fail"
        printf 'BENCH_RES\t%s\t%s\t0\t2\t0\t%s\t0\t0\n' "$strat_idx" "$st" "$f_reason"
        strat_idx=$((strat_idx + 1))
        continue
      fi
    fi

    local tmp_res="$STATE_DIR/bench_res.$$.tmp"
    : > "$tmp_res"
    local h batch=0
    while IFS= read -r h; do
      [ -z "$h" ] && continue
      case "$h" in \#*) continue ;; esac
      (
        local k=1
        while [ "$k" -le 3 ]; do
          local r
          r=$(probe_attempt "$kind" "$bin" "$h" "$k")
          printf '%s\t%s\t%s\n' "$h" "$k" "$r" >> "$tmp_res"
          k=$((k + 1))
        done
      ) &
      batch=$((batch + 1))
      if [ "$batch" -ge 5 ]; then
        wait
        batch=0
      fi
    done < "$bench_hosts_file"
    wait

    local ok_cnt=0 total_cnt=0 sum_ms=0 fail_reasons=""
    local yt_ok_cnt=0 yt_sum_ms=0 dc_ok_cnt=0 dc_sum_ms=0
    while IFS="$(printf '\t')" read -r h_val k r_val; do
      [ -z "$r_val" ] && continue
      local r_st="${r_val%% *}" r_detail="${r_val#* }"
      total_cnt=$((total_cnt + 1))
      local is_yt=0 is_dc=0
      case "$h_val" in *youtube*|*googlevideo*) is_yt=1 ;; esac
      case "$h_val" in *discord*) is_dc=1 ;; esac
      if [ "$r_st" = "ok" ]; then
        ok_cnt=$((ok_cnt + 1))
        sum_ms=$((sum_ms + ${r_detail:-0}))
        if [ "$is_yt" -eq 1 ]; then yt_ok_cnt=$((yt_ok_cnt + 1)); yt_sum_ms=$((yt_sum_ms + ${r_detail:-0})); fi
        if [ "$is_dc" -eq 1 ]; then dc_ok_cnt=$((dc_ok_cnt + 1)); dc_sum_ms=$((dc_sum_ms + ${r_detail:-0})); fi
      else
        fail_reasons="$fail_reasons $r_detail"
      fi
    done < "$tmp_res"
    rm -f "$tmp_res"

    local avg_ms=0
    if [ "$ok_cnt" -gt 0 ]; then avg_ms=$((sum_ms / ok_cnt)); fi

    local top_fail="-"
    if [ -n "$fail_reasons" ]; then
      top_fail=$(printf '%s\n' $fail_reasons | sort | uniq -c | sort -nr | head -1 | awk '{print $2}')
      [ -z "$top_fail" ] && top_fail="-"
    fi

    printf 'BENCH_RES\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$strat_idx" "$st" "$ok_cnt" "$total_cnt" "$avg_ms" "$top_fail" "$yt_ok_cnt" "$dc_ok_cnt"

    if [ "$ok_cnt" -gt "$best_ok" ] || { [ "$ok_cnt" -eq "$best_ok" ] && [ "$best_ok" -gt 0 ] && [ "$avg_ms" -lt "$best_ms" ]; }; then
      best_ok="$ok_cnt"
      best_total="$total_cnt"
      best_ms="$avg_ms"
      best_name="$st"
    fi

    local yt_avg=99999
    if [ "$yt_ok_cnt" -gt 0 ]; then yt_avg=$((yt_sum_ms / yt_ok_cnt)); fi
    if [ "$yt_ok_cnt" -gt "$best_yt_ok" ] || { [ "$yt_ok_cnt" -eq "$best_yt_ok" ] && [ "$best_yt_ok" -gt 0 ] && [ "$yt_avg" -lt "$best_yt_ms" ]; }; then
      best_yt_ok="$yt_ok_cnt"
      best_yt_ms="$yt_avg"
      best_yt="$st"
    fi

    local dc_avg=99999
    if [ "$dc_ok_cnt" -gt 0 ]; then dc_avg=$((dc_sum_ms / dc_ok_cnt)); fi
    if [ "$dc_ok_cnt" -gt "$best_dc_ok" ] || { [ "$dc_ok_cnt" -eq "$best_dc_ok" ] && [ "$best_dc_ok" -gt 0 ] && [ "$dc_avg" -lt "$best_dc_ms" ]; }; then
      best_dc_ok="$dc_ok_cnt"
      best_dc_ms="$dc_avg"
      best_dc="$st"
    fi

    strat_idx=$((strat_idx + 1))
  done

  if [ "$best_ok" -gt 0 ] && [ "$kind" = "curl" ]; then
    local quic_test_h="www.youtube.com"
    if [ -n "$target_domain" ]; then
      quic_test_h="$target_domain"
    fi
    local qr
    qr=$(probe_attempt "$kind" "$bin" "$quic_test_h" 4)
    if [ "${qr%% *}" = "fail" ]; then
      printf 'BENCH_QUIC\t%s\tblocked\tescalated\n' "$quic_test_h"
    elif [ "${qr%% *}" = "ok" ]; then
      printf 'BENCH_QUIC\t%s\tok\n' "$quic_test_h"
    fi
  fi

  bench_cleanup
  trap - EXIT INT TERM

  [ -z "$best_name" ] && best_name="-"
  [ -z "$best_yt" ] && best_yt="-"
  [ -z "$best_dc" ] && best_dc="-"
  printf 'BENCH_BEST\t%s\t%s\t%s\t%s\t%s\t%s\n' "$best_name" "$best_ok" "$best_total" "$best_ms" "$best_yt" "$best_dc"
}

cmd_probe_dpi() {
  local mode="${1:-all}" target_domain="${2:-}" tool kind bin
  tool=$(probe_tool); kind="${tool%% *}"; bin="${tool#* }"
  printf 'tool\t%s\n' "$kind"
  [ "$kind" = "none" ] && { echo done; return 0; }
  mkdir -p "$STATE_DIR"
  echo "$$" > "$STATE_DIR/probe.pid"
  setup_probe_app_rule
  trap 'rm -f "$STATE_DIR/probe.pid" "$STATE_DIR/probe.hosts.$$"; cleanup_probe_app_rule' EXIT
  trap 'trap - EXIT; rm -f "$STATE_DIR/probe.pid" "$STATE_DIR/probe.hosts.$$"; cleanup_probe_app_rule; exit 130' INT TERM

  case "$mode" in
    net) cmd_net_info ;;
    web) cmd_probe_all_inner "$kind" "$bin" "$target_domain" ;;
    tcp16) cmd_probe_tcp16 ;;
    dns) cmd_probe_dns ;;
    tg) cmd_probe_tg ;;
    bench) cmd_bench_strategies "$target_domain" ;;
    all|*)
      cmd_net_info
      cmd_probe_all_inner "$kind" "$bin" "$target_domain"
      cmd_probe_tcp16
      cmd_probe_dns
      ;;
  esac

  rm -f "$STATE_DIR/probe.pid"
  cleanup_probe_app_rule
  echo done
}

# ---------------------------------------------------------------- обновления списков
# Установщик кладёт новую версию списка в .pending, если пользователь правил
# свой; здесь её можно принять.
cmd_list_update() { # <имя списка>
  local f p
  f=$(list_file "$1") || { echo "Неизвестный список" >&2; return 1; }
  p="$LISTS_PENDING_DIR/${f##*/}"
  [ -f "$p" ] || { echo "Обновления для ${f##*/} нет" >&2; return 1; }
  cp -f "$p" "$f" || { echo "Не удалось обновить ${f##*/}" >&2; return 1; }
  chmod 0644 "$f"
  rm -f "$p"
  reload_after_change
  echo OK
}

# Список записан на диск, но служба его ещё не перечитала. Провал перезагрузки
# говорим словами, а не глотаем: правка сделана, но в работу не пошла — это важно
# знать. Код возврата не роняем, потому что основное действие уже выполнено; а вот
# провал самого действия роняет — раньше он не ронял ничего (см. ветки ниже).
reload_after_change() {
  is_running || return 0
  sh "$SERVICE" reload >/dev/null 2>&1 && return 0
  echo "Списки сохранены, но служба их не перечитала — перезапустите вручную" >&2
}

cmd_googlevideo_discovery() {
  local force="${1:-}" cdn
  cdn=$(resolve_googlevideo_cdn "$force")
  printf 'GOOGLEVIDEO_CDN\t%s\n' "$cdn"
}

cmd_orchestra_status() {
  orchestra_status
  if [ -f "$ORCHESTRA_MEMORY_FILE" ]; then
    cat "$ORCHESTRA_MEMORY_FILE"
  fi
}

cmd_orchestra_lock() {
  orchestra_lock_strategy "$1" "$2" || { echo "Использование: nfqws2-ctl orchestra-lock <host> <strategy_index>" >&2; exit 1; }
  echo OK
}

cmd_orchestra_unlock() {
  orchestra_unlock_strategy "$1" || { echo "Использование: nfqws2-ctl orchestra-unlock <host>" >&2; exit 1; }
  echo OK
}

cmd_orchestra_block() {
  orchestra_block_strategy "$1" "$2" || { echo "Использование: nfqws2-ctl orchestra-block <host> <strategy_index>" >&2; exit 1; }
  echo OK
}

cmd_orchestra_unblock() {
  orchestra_unblock_strategy "$1" "$2" || { echo "Использование: nfqws2-ctl orchestra-unblock <host> [strategy_index]" >&2; exit 1; }
  echo OK
}

cmd_orchestra_clear() {
  rm -f "$ORCHESTRA_MEMORY_FILE"
  orchestra_memory_init
  echo OK
}

cmd_list_catalogs() {
  local cat label file cnt
  for cat in tcp_tls tcp_http udp_quic udp_voice; do
    case "$cat" in
      tcp_tls) label="TCP TLS (HTTPS)" ;;
      tcp_http) label="HTTP 80" ;;
      udp_quic) label="UDP QUIC (HTTP/3)" ;;
      udp_voice) label="Voice (Discord/STUN)" ;;
    esac
    file=$(catalog_file "$cat" 2>/dev/null)
    cnt=0
    if [ -n "$file" ] && [ -f "$file" ]; then
      cnt=$(grep -cvE '^[[:space:]]*(#|$)' "$file" 2>/dev/null || :)
      [ -n "$cnt" ] || cnt=0
    fi
    printf '%s\t%s\t%s\n' "$cat" "$label" "$cnt"
  done
}

cmd_get_catalog() {
  local cat="$1" file idx=0 line
  file=$(catalog_file "$cat" 2>/dev/null)
  if [ -z "$file" ] || [ ! -f "$file" ]; then
    echo "Каталог '$cat' не найден" >&2
    return 1
  fi
  while IFS= read -r line; do
    case "$line" in
      ''|\#*) continue ;;
    esac
    idx=$((idx + 1))
    printf '%d\t%s\n' "$idx" "$line"
  done < "$file"
}

cmd_catalog_apply_module() {
  local cat="$1" idx="$2" file line cur_idx=0
  file=$(catalog_file "$cat" 2>/dev/null)
  if [ -z "$file" ] || [ ! -f "$file" ]; then
    echo "Каталог '$cat' не найден" >&2
    return 1
  fi
  case "$idx" in
    ''|*[!0-9]*) echo "Некорректный номер: $idx" >&2; return 1 ;;
  esac
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue ;; esac
    cur_idx=$((cur_idx + 1))
    if [ "$cur_idx" -eq "$idx" ]; then
      break
    fi
  done < "$file"
  if [ "$cur_idx" -ne "$idx" ] || [ -z "$line" ]; then
    echo "Элемент #$idx не найден в каталоге $cat" >&2
    return 1
  fi

  local tmp="$STATE_DIR/cat_apply.$$.conf"
  archive_replaced_preset "$CONFFILE"
  save_working_snapshot "$CONFFILE" 2>/dev/null || true

  case "$cat" in
    udp_quic)
      awk -v desync="$line" '
        BEGIN { in_q = 0 }
        /^NFQWS_ARGS_QUIC="/ {
          print "NFQWS_ARGS_QUIC=\"--filter-udp=443 --filter-l7=quic"
          print "                 --payload=quic_initial"
          print "                 " desync "\""
          if ($0 ~ /"[[:space:]]*$/ && $0 !~ /^NFQWS_ARGS_QUIC="[[:space:]]*$/) { in_q = 0 }
          else { in_q = 1 }
          next
        }
        in_q {
          if ($0 ~ /"/) { in_q = 0 }
          next
        }
        { print }
      ' "$CONFFILE" > "$tmp"
      ;;
    udp_voice)
      awk -v desync="$line" '
        BEGIN { in_u = 0 }
        /^NFQWS_ARGS_UDP="/ {
          print "NFQWS_ARGS_UDP=\"--filter-udp=590-600,1400,3478-3481,5349,19294-19344,49152-65535"
          print "                --filter-l7=wireguard,stun,discord,unknown"
          print "                --out-range=<n2"
          print "                --payload=wireguard_initiation,wireguard_response,wireguard_cookie,stun,discord_ip_discovery,unknown"
          print "                " desync "\""
          if ($0 ~ /"[[:space:]]*$/ && $0 !~ /^NFQWS_ARGS_UDP="[[:space:]]*$/) { in_u = 0 }
          else { in_u = 1 }
          next
        }
        in_u {
          if ($0 ~ /"/) { in_u = 0 }
          next
        }
        { print }
      ' "$CONFFILE" > "$tmp"
      ;;
    tcp_http)
      awk -v desync="$line" '
        BEGIN { in_http = 0 }
        /--payload=http_req/ {
          print "            --payload=http_req"
          print "            " desync "\""
          in_http = 1
          next
        }
        in_http {
          if ($0 ~ /"/) { in_http = 0 }
          next
        }
        { print }
      ' "$CONFFILE" > "$tmp"
      ;;
    tcp_tls)
      awk -v desync="$line" '
        BEGIN { in_tls = 0 }
        /--payload=tls_client_hello/ {
          print "            --payload=tls_client_hello"
          print "            " desync
          in_tls = 1
          next
        }
        in_tls {
          if ($0 ~ /--payload=http_req/) {
            in_tls = 0
            print
            next
          }
          if ($0 ~ /"/) {
            in_tls = 0
            print
            next
          }
          next
        }
        { print }
      ' "$CONFFILE" > "$tmp"
      ;;
  esac

  if cmp -s "$tmp" "$CONFFILE"; then
    rm -f "$tmp"
    echo "Модуль не применён: в конфиге нет блока для каталога $cat" >&2
    return 1
  fi

  local err
  if ! err=$(validate_conf_file "$tmp" 2>&1); then
    echo "Ошибка валидации при подмене модуля: $err" >&2
    rm -f "$tmp"
    return 1
  fi

  cp -f "$CONFFILE" "$CONFFILE.bak" 2>/dev/null
  mv -f "$tmp" "$CONFFILE"
  chmod 0644 "$CONFFILE"
  echo "OK: модуль $cat (#$idx) успешно внедрён в действующий пресет"
  need_restart_note
}

cmd_list_replaced_strategies() {
  local rep_dir="$CONFDIR/strategies/replaced" f bname dt sz
  if [ ! -d "$rep_dir" ]; then
    return 0
  fi
  for f in "$rep_dir"/*.conf; do
    [ -f "$f" ] || continue
    bname="${f##*/}"
    sz=$(wc -c < "$f" 2>/dev/null || echo 0)
    dt=$(echo "$bname" | sed -n 's/.*[._]\([0-9]\{8\}_[0-9]\{6\}\)\.conf/\1/p')
    if [ -z "$dt" ]; then
      dt=$(date -r "$f" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "—")
    else
      dt=$(echo "$dt" | sed 's/^\([0-9]\{4\}\)\([0-9]\{2\}\)\([0-9]\{2\}\)_\([0-9]\{2\}\)\([0-9]\{2\}\)\([0-9]\{2\}\)/\1-\2-\3 \4:\5:\6/')
    fi
    printf '%s\t%s\t%s\n' "$bname" "$dt" "$sz"
  done | sort -r -k2
}

cmd_restore_replaced_strategy() {
  local name="$1" f
  case "$name" in
    ''|*/*|*\\*|..*) echo "Некорректное имя файла" >&2; return 1 ;;
  esac
  case "$name" in
    *.conf) f="$CONFDIR/strategies/replaced/$name" ;;
    *) f="$CONFDIR/strategies/replaced/$name.conf" ;;
  esac
  if [ ! -f "$f" ]; then
    echo "Архивный пресет не найден: $name" >&2
    return 1
  fi
  local err
  if ! err=$(validate_conf_file "$f" 2>&1); then
    echo "Ошибка валидации архивного пресета: $err" >&2
    return 1
  fi
  archive_replaced_preset "$CONFFILE"
  save_working_snapshot "$CONFFILE" 2>/dev/null || true
  cp -f "$CONFFILE" "$CONFFILE.bak" 2>/dev/null
  cp -f "$f" "$CONFFILE"
  chmod 0644 "$CONFFILE"
  echo "OK: пресет восстановлен из архива $name"
  need_restart_note
}

cmd_tg_affinity() {
  if [ ! -s "$TG_AFFINITY_FILE" ]; then
    cmd_probe_tg >/dev/null 2>&1
  fi
  if [ -s "$TG_AFFINITY_FILE" ]; then cat "$TG_AFFINITY_FILE"; else echo '{}'; fi
}

# ---------------------------------------------------------------- цвета системы
# Тема WebUI «как у системы»: готовые цвета ролей Material You (Android 14+:
# android:color/system_<роль>_light|_dark и *_fixed) — их Android считает сам,
# со стилем прошивки (тональный, яркий, выразительный…) и контрастом, поэтому
# WebUI выглядит как «Настройки». cmd overlay lookup — по процессу на цвет, это
# секунды, поэтому ответ хранится в state/monet.cache, пока не сменятся обои
# или стиль (secure theme_customization_overlay_packages). Вывод: строки
# «style ИМЯ», «seed #rrggbb», «роль режим #rrggbb» (режим light|dark|fixed)
MONET_ROLES="primary on_primary primary_container on_primary_container secondary on_secondary secondary_container on_secondary_container tertiary on_tertiary tertiary_container on_tertiary_container error on_error error_container on_error_container background on_background surface on_surface surface_variant on_surface_variant surface_dim surface_bright surface_container_lowest surface_container_low surface_container surface_container_high surface_container_highest outline outline_variant"
MONET_FIXED="primary_fixed primary_fixed_dim on_primary_fixed on_primary_fixed_variant secondary_fixed secondary_fixed_dim on_secondary_fixed on_secondary_fixed_variant tertiary_fixed tertiary_fixed_dim on_tertiary_fixed on_tertiary_fixed_variant"
cmd_monet_system() {
  local key cache="$STATE_DIR/monet.cache" tmp style seed n=0 r m name f
  key=$(settings get secure theme_customization_overlay_packages 2>/dev/null | tr -d '\r\n')
  case "$key" in ''|null) key="" ;; esac
  if [ -f "$cache" ] && [ "$(head -n 1 "$cache")" = "key $key" ]; then
    tail -n +2 "$cache"; return 0
  fi
  style=$(printf '%s' "$key" | sed -n 's/.*"android\.theme\.customization\.theme_style"[[:space:]]*:[[:space:]]*"\([A-Z_]*\)".*/\1/p')
  seed=$(printf '%s' "$key" | sed -n 's/.*"android\.theme\.customization\.system_palette"[[:space:]]*:[[:space:]]*"\(#\{0,1\}\)\([0-9A-Fa-f]\{6,8\}\)".*/\2/p')
  [ ${#seed} -eq 8 ] && seed=${seed#??}
  tmp="$STATE_DIR/monet.d"; rm -rf "$tmp"; mkdir -p "$tmp" || return 1
  # по 12 запросов разом: каждый — отдельный процесс Java
  for r in $MONET_ROLES $MONET_FIXED; do
    case " $MONET_FIXED " in *" $r "*) set -- "$r:fixed" ;; *) set -- "$r:light" "$r:dark" ;; esac
    for m in "$@"; do
      name="system_${m%%:*}"; [ "${m#*:}" = fixed ] || name="${name}_${m#*:}"
      ( v=$(cmd overlay lookup android "android:color/$name" 2>/dev/null | grep -oiE '#[0-9a-f]{6,8}' | tail -n 1)
        [ -n "$v" ] && printf '%s %s #%s\n' "${m%%:*}" "${m#*:}" "$(printf '%s' "${v#\#}" | tail -c 6 | tr 'A-F' 'a-f')" > "$tmp/$name" ) &
      n=$((n + 1))
      [ $((n % 12)) -eq 0 ] && wait
    done
  done
  wait
  {
    echo "key $key"
    [ -n "$style" ] && echo "style $style"
    [ -n "$seed" ] && echo "seed #$(printf '%s' "$seed" | tr 'A-F' 'a-f')"
    # ни одного цвета (Android до 14) — тоже ответ: стиль и сид
    for f in "$tmp"/*; do [ -f "$f" ] && cat "$f"; done
    true
  } > "$cache.tmp" && mv -f "$cache.tmp" "$cache"
  rm -rf "$tmp"
  tail -n +2 "$cache"
}

case "$1" in
  status) cmd_status ;;
  json-status) cmd_json_status ;;
  is-running) is_running ;;
  start|stop|restart|reload) sh "$SERVICE" "$1" ;;
  rollback) sh "$SERVICE" rollback ;;
  list-catalogs) cmd_list_catalogs ;;
  get-catalog) cmd_get_catalog "$2" ;;
  catalog-apply-module) cmd_catalog_apply_module "$2" "$3" ;;
  list-replaced-strategies) cmd_list_replaced_strategies ;;
  restore-replaced-strategy) cmd_restore_replaced_strategy "$2" ;;
  tcp16-status) cmd_tcp16_status ;;
  googlevideo-discovery) cmd_googlevideo_discovery "$2" ;;
  orchestra-status) cmd_orchestra_status ;;
  orchestra-lock) cmd_orchestra_lock "$2" "$3" ;;
  orchestra-unlock) cmd_orchestra_unlock "$2" ;;
  orchestra-block) cmd_orchestra_block "$2" "$3" ;;
  orchestra-unblock) cmd_orchestra_unblock "$2" "$3" ;;
  orchestra-clear) cmd_orchestra_clear ;;
  tg-affinity) cmd_tg_affinity ;;
  doctor) cmd_doctor ;;

  check|dry-run)
    target="${2:-$CONFFILE}"
    if [ ! -f "$target" ]; then
      echo "Файл не найден: $target" >&2
      exit 1
    fi
    if err=$(validate_conf_file "$target" 2>&1); then
      echo "OK: параметры nfqws2 проверены (--dry-run)"
      exit 0
    else
      echo "Ошибка проверки: $err" >&2
      exit 1
    fi ;;

  get-conf) cat "$CONFFILE" ;;
  save-conf-b64)
    t="$STATE_DIR/save.tmp"; b64d "$2" | tr -d '\r' > "$t"
    if [ ! -s "$t" ]; then echo "Пустой конфиг" >&2; rm -f "$t"; exit 1; fi
    if err=$(validate_conf_file "$t" 2>&1); then
      cp -f "$CONFFILE" "$CONFFILE.bak" 2>/dev/null; mv -f "$t" "$CONFFILE"; chmod 0644 "$CONFFILE"; echo OK; need_restart_note
    else echo "Конфиг отклонён: $err" >&2; rm -f "$t"; exit 1; fi ;;
  # Сброс — к исходнику текущей стратегии, а не к стандартному конфигу: так
  # «Сбросить» отменяет ручные правки, не меняя выбранную стратегию.
  reset-conf)
    cur=$(get_current_strategy)
    if [ "$cur" != "default" ] && ! strategy_file "$cur" >/dev/null; then cur=default; fi
    set_strategy "$cur" >/dev/null && echo OK ;;
  conf-modified) conf_modified ;;

  list-strategies) list_strategies ;;
  get-strategy) get_current_strategy ;;
  set-strategy) set_strategy "$2" ;;
  strategy-get-b64)
    case "$2" in default) f="$MODDIR/defaults/nfqws2.conf" ;; *) f=$(strategy_file "$2") ;; esac
    [ -n "$f" ] && [ -f "$f" ] || { echo "Стратегия не найдена" >&2; exit 1; }
    # Импорт из старой версии мог остаться в исходном виде Keenetic —
    # в редактор он попадает уже приведённым к виду встроенной стратегии.
    case "$2" in imp:*) normalize_import "$f" ;; *) cat "$f" ;; esac \
      | b64e ;;
  strategy-save-b64)
    n="$2"; t="$STATE_DIR/strat_save.$$.tmp"
    case "$n" in default|'') echo "Стандартную стратегию редактируйте во вкладке «Конфиг»" >&2; exit 1 ;; esac
    strategy_name_ok "${n#imp:}" || { echo "Некорректное имя" >&2; exit 1; }
    strategy_file "$n" >/dev/null || { echo "Стратегия не найдена" >&2; exit 1; }
    b64d "$3" | tr -d '\r' > "$t"
    [ -s "$t" ] || { echo "Пустая стратегия" >&2; rm -f "$t"; exit 1; }
    if ! err=$(validate_conf "$t" 2>&1); then echo "Стратегия отклонена: $err" >&2; rm -f "$t"; exit 1; fi
    test_conf="$STATE_DIR/strat_test.$$.tmp"
    if merge_user_keys "$t" "$CONFFILE" > "$test_conf" 2>/dev/null; then
      if ! err=$(validate_conf_file "$test_conf" 2>&1); then
        echo "Стратегия отклонена: $err" >&2
        rm -f "$t" "$test_conf"
        exit 1
      fi
    fi
    rm -f "$test_conf"
    case "$n" in
      imp:*) dst="$IMPORTS_DIR/${n#imp:}.conf" ;;
      *) dst="$USER_STRATEGIES_DIR/$n.conf"
         b=$(strategy_builtin_file "$n")
         # Текст совпал с исходником — правки нет, копия не нужна.
         if [ -n "$b" ] && cmp -s "$t" "$b"; then rm -f "$t" "$dst"; echo OK; exit 0; fi ;;
    esac
    [ -f "$dst" ] && archive_replaced_preset "$dst"
    mv -f "$t" "$dst" && chmod 0644 "$dst" && echo OK ;;
  strategy-reset)
    strategy_name_ok "$2" && strategy_builtin_file "$2" >/dev/null || { echo "Это не встроенная стратегия" >&2; exit 1; }
    rm -f "$USER_STRATEGIES_DIR/$2.conf"; echo OK ;;

  import-add-b64)
    t="$STATE_DIR/imp.$$.in"; b64d "$3" > "$t"
    cmd_import_add "$(b64d "$2")" "$t"; rc=$?; rm -f "$t"; exit $rc ;;
  list-imports) list_imports ;;
  get-import-merged-b64)
    strategy_name_ok "$2" || { echo "Некорректное имя" >&2; exit 1; }
    f="$IMPORTS_DIR/$2.conf"
    [ -f "$f" ] || { echo "Импорт не найден" >&2; exit 1; }
    render_import_merged "$f" | b64e ;;
  delete-import)
    strategy_name_ok "$2" || { echo "Некорректное имя" >&2; exit 1; }
    rm -f "$IMPORTS_DIR/$2.conf"
    # Удалённый импорт был активной стратегией: конфиг остаётся, но вернуть его
    # «к исходнику» больше не к чему — дальше он считается стандартным.
    [ "$(get_current_strategy)" = "imp:$2" ] && echo default > "$ACTIVE_FILE"
    echo OK ;;
  rename-import)
    strategy_name_ok "$2" || { echo "Некорректное текущее имя" >&2; exit 1; }
    src="$IMPORTS_DIR/$2.conf"
    [ -f "$src" ] || { echo "Импорт не найден" >&2; exit 1; }
    newname=$(import_safe_name "$3")
    [ -n "$newname" ] || { echo "Пустое имя" >&2; exit 1; }
    dst="$IMPORTS_DIR/$newname.conf"
    if [ "$src" != "$dst" ]; then
      [ -f "$dst" ] && { echo "Такое имя уже есть" >&2; exit 1; }
      mv -f "$src" "$dst"
      [ "$(get_current_strategy)" = "imp:$2" ] && echo "imp:$newname" > "$ACTIVE_FILE"
    fi
    echo "$newname" ;;

  get-list) f=$(list_file "$2") || { echo "Неизвестный список" >&2; exit 1; }
    [ -f "$f" ] || cp -f "$MODDIR/defaults/lists/${f##*/}" "$f" 2>/dev/null || cp -f "$MODDIR/lists/${f##*/}" "$f" 2>/dev/null
    if [ -f "$f" ]; then cat "$f"; fi ;;
  save-list-b64) f=$(list_file "$2") || { echo "Неизвестный список" >&2; exit 1; }
    # Проверяем саму запись: без этого упавший mv (полный диск, права, каталог
    # на месте файла) заканчивался `echo OK`, и правки пользователя молча
    # терялись — UI показывал успех.
    { b64d "$3" | tr -d '\r' > "$f.tmp"; } && mv -f "$f.tmp" "$f" ||
      { rm -f "$f.tmp"; echo "Не удалось сохранить ${f##*/}" >&2; exit 1; }
    chmod 0644 "$f"
    rm -f "$LIST_COUNTS_CACHE" 2>/dev/null
    # Пользователь сам привёл список к новой версии — предлагать её больше незачем.
    cmp -s "$f" "$LISTS_PENDING_DIR/${f##*/}" 2>/dev/null && rm -f "$LISTS_PENDING_DIR/${f##*/}"
    if [ "$2" = "apps" ]; then cmd_apply_apps; exit $?; fi
    if [ "$2" = "home" ]; then sh "$SERVICE" home_check >/dev/null 2>&1; echo OK; exit 0; fi
    reload_after_change; echo OK ;;
  save-list-chunk-b64)
    f=$(list_file "$2") || { echo "Неизвестный список" >&2; exit 1; }
    chunk_idx="$3"
    total_chunks="$4"
    b64_data="$5"
    case "$chunk_idx" in ''|*[!0-9]*) echo "Некорректный номер чанка: $chunk_idx" >&2; exit 1 ;; esac
    case "$total_chunks" in ''|*[!0-9]*) echo "Некорректное число чанков: $total_chunks" >&2; exit 1 ;; esac
    tmp="$f.chunk_tmp"
    if [ "$chunk_idx" = "1" ]; then
      rm -f "$tmp"
      { b64d "$b64_data" | tr -d '\r' > "$tmp"; } || { rm -f "$tmp"; echo "Не удалось записать чанк 1" >&2; exit 1; }
    else
      { b64d "$b64_data" | tr -d '\r' >> "$tmp"; } || { rm -f "$tmp"; echo "Не удалось дописать чанк $chunk_idx" >&2; exit 1; }
    fi
    if [ "$chunk_idx" -ge "$total_chunks" ]; then
      ensure_eol "$tmp"
      mv -f "$tmp" "$f" && chmod 0644 "$f" || { rm -f "$tmp"; echo "Не удалось сохранить ${f##*/}" >&2; exit 1; }
      rm -f "$LIST_COUNTS_CACHE" 2>/dev/null
      cmp -s "$f" "$LISTS_PENDING_DIR/${f##*/}" 2>/dev/null && rm -f "$LISTS_PENDING_DIR/${f##*/}"
      if [ "$2" = "apps" ]; then cmd_apply_apps; exit $?; fi
      if [ "$2" = "home" ]; then sh "$SERVICE" home_check >/dev/null 2>&1; echo OK; exit 0; fi
      reload_after_change; echo OK
    else
      echo "CHUNK $chunk_idx/$total_chunks OK"
    fi ;;
  get-list-chunk)
    f=$(list_file "$2") || { echo "Неизвестный список" >&2; exit 1; }
    [ -f "$f" ] || cp -f "$MODDIR/defaults/lists/${f##*/}" "$f" 2>/dev/null || cp -f "$MODDIR/lists/${f##*/}" "$f" 2>/dev/null
    if [ -f "$f" ]; then
      offset="${3:-1}"
      limit="${4:-5000}"
      case "$offset" in ''|*[!0-9]*) offset=1 ;; esac
      case "$limit" in ''|*[!0-9]*) limit=5000 ;; esac
      tail -n "+$offset" "$f" 2>/dev/null | head -n "$limit"
    fi ;;
  list-line-count)
    f=$(list_file "$2") || { echo 0; exit 1; }
    list_line_count "$f" ;;
  list-update) cmd_list_update "$2" ;;
  add-domain)
    d=$(printf '%s' "$2" | tr 'A-Z' 'a-z' | sed 's#^[a-z]*://##; s#/.*##; s/^www\.//')
    case "$d" in ''|*[!a-z0-9.-]*) echo "Некорректный домен" >&2; exit 1 ;; esac
    ul="$LISTS_DIR/user.list"
    # echo >> склеил бы новый домен с последней строкой, если файл не заканчивается переводом:
    # портились обе записи, и проверка дедупликации ниже тоже переставала срабатывать.
    ensure_eol "$ul"
    if ! grep -qx "$d" "$ul" 2>/dev/null; then
      printf '%s\n' "$d" >> "$ul" || { echo "Не удалось записать ${ul##*/}" >&2; exit 1; }
    fi
    reload_after_change; echo "Добавлено: $d" ;;
  clear-auto)
    : > "$LISTS_DIR/auto.list" || { echo "Не удалось очистить auto.list" >&2; exit 1; }
    reload_after_change; echo OK ;;
  # auto.list здесь намеренно нет: он выученный, и сброс не должен стирать
  # наработку — для него есть отдельная команда clear-auto. Установщик
  # (customize.sh) кладёт все шесть, включая auto. Списки обязаны различаться
  # ровно на auto, это проверяет test_data.sh.
  reset-lists)
    for f in user exclude ipset ipset_exclude probe_hosts; do
      cp -f "$MODDIR/defaults/lists/$f.list" "$LISTS_DIR/$f.list" ||
        { echo "Не удалось восстановить $f.list" >&2; exit 1; }
      rm -f "$LISTS_PENDING_DIR/$f.list"
    done
    reload_after_change; echo OK ;;

  set)
    case "$2" in
      BLOCK_QUIC|AUTOSTART|WATCHDOG|IPV6_ENABLED|NAT_FIX|LOG_LEVEL|WAKELOCK|HOME_WIFI|ENABLE_HOTSPOT|NET_STRATEGY|VPN_PAUSE|META_QUIC_REJECT|CALLS_BYPASS|TCP_MSS_CLAMP|WL_PAUSE|SMART_LEARN) case "$3" in 0|1) ;; *) echo "Допустимо 0 или 1" >&2; exit 1 ;; esac ;;
      PKT_LIMIT_OUT|PKT_LIMIT_IN) case "$3" in [1-9]|1[0-5]) ;; *) echo "Допустимо 1..15" >&2; exit 1 ;; esac ;;
      APP_MODE) case "$3" in off|include|exclude) ;; *) echo "off|include|exclude" >&2; exit 1 ;; esac ;;
      *) echo "Параметр $2 нельзя менять этой командой" >&2; exit 1 ;;
    esac
    set_conf_param "$2" "$3"; echo OK
    case "$2" in
      APP_MODE) load_conf >/dev/null 2>&1; cmd_apply_apps ;;
      # Пауза в домашней сети, VPN и наблюдатели не требуют перезапуска службы
      HOME_WIFI|WATCHDOG|VPN_PAUSE) sh "$SERVICE" home_check >/dev/null 2>&1 ;;
      WL_PAUSE) [ "$3" = 0 ] && rm -f "$WL_FILE"; sh "$SERVICE" home_check >/dev/null 2>&1 ;;
      SMART_LEARN) ;;
      ENABLE_HOTSPOT|TCP_MSS_CLAMP) load_conf >/dev/null 2>&1; sh "$SERVICE" firewall_apply >/dev/null 2>&1 ;;
      # отдельная цепочка — меняется без перезапуска службы
      META_QUIC_REJECT) load_conf >/dev/null 2>&1; if is_running; then meta_quic_start; fi ;;
      NET_STRATEGY) load_conf >/dev/null 2>&1; sh "$SERVICE" net_check >/dev/null 2>&1; sh "$SERVICE" ensure_watchdog >/dev/null 2>&1 ;;
      WAKELOCK)
        load_conf >/dev/null 2>&1
        if is_running; then
          if [ "$3" = "1" ]; then acquire_wakelock; else release_wakelock; fi
        fi ;;
      AUTOSTART) ;;
      *) need_restart_note ;;
    esac ;;
  set-mode)
    case "$2" in list|auto|all) set_conf_param NFQWS_EXTRA_ARGS "\$MODE_$(printf '%s' "$2" | tr a-z A-Z)"; echo OK; need_restart_note ;;
      *) echo "list|auto|all" >&2; exit 1 ;; esac ;;
  list-apps) cmd_list_apps "$2" ;;
  get-logs) cmd_get_logs "$2" "$3" "$4" ;;
  export-logs) cmd_export_logs ;;
  wifi-ssid) current_ssid || exit 1 ;;
  current-network) current_network_title 2>/dev/null || echo "unknown" ;;
  list-net-strategies) list_net_strategies ;;
  clear-net-strategies) clear_net_strategies; echo OK ;;
  backup-create) cmd_backup_create "$2" ;;
  backup-list) cmd_backup_list ;;
  backup-restore) cmd_backup_restore "$2" ;;
  backup-restore-b64) cmd_backup_restore_b64 "$2" ;;
  net-info) cmd_net_info ;;
  probe-dpi) cmd_probe_dpi "${2:-all}" "$3" ;;
  bench-strategies) cmd_bench_strategies "$2" ;;
  check-domain) cmd_check_domain "$2" ;;
  domain-check) cmd_domain_check "$2" ;;
  home-pause)
    rm -f "$HOME_OVERRIDE_FILE"
    sh "$SERVICE" home_check >/dev/null 2>&1
    [ -f "$HOME_PAUSED_FILE" ] && echo OK || { echo "$(M 'Причины для паузы больше нет: телефон не в домашней сети и VPN выключен' 'Nothing to pause for: not on home Wi‑Fi and VPN is off')" >&2; exit 1; } ;;
  net-recheck) sh "$SERVICE" net_recheck >/dev/null 2>&1; echo OK ;;
  upload)
    f=$(upload_file "@up:$2") || { echo "Неверная метка" >&2; exit 1; }
    mkdir -p "$UPLOAD_DIR" || exit 1
    find "$UPLOAD_DIR" -type f -mmin +30 -exec rm -f {} + 2>/dev/null
    cat >> "$f" <<EOF
$3
EOF
    echo OK ;;
  share) cmd_share "$2" "$3" ;;
  changelog) cat "$MODDIR/changelog.md" 2>/dev/null || { echo "Нет changelog.md в модуле" >&2; exit 1; } ;;
  smart-status) cmd_smart_status "$2" ;;
  smart-reset) cmd_smart_reset "${2:-all}" ;;
  smart-sites) cmd_smart_sites "$2" "$3" ;;
  smart-export) cmd_smart_export "$2" "$3" ;;
  smart-import-b64) cmd_smart_import_b64 "$2" ;;
  smart-learn-once) cmd_smart_learn_once ;;
  monet-system) cmd_monet_system ;;
  probe-cancel) cmd_probe_cancel ;;
  clear-logs) : > "$SERVICE_LOG"; : > "$NFQWS_LOG"; rm -f "$LOG_DIR/nfqws2-debug.log" "$LOG_DIR/auto.log"; echo OK ;;
  *)
    echo "Команды: status json-status is-running check dry-run start stop restart reload doctor get-conf save-conf-b64 reset-conf conf-modified" >&2
    echo "         list-strategies get-strategy set-strategy strategy-get-b64 strategy-save-b64 strategy-reset" >&2
    echo "         import-add-b64 list-imports get-import-merged-b64 rename-import delete-import" >&2
    echo "         get-list save-list-b64 list-update add-domain clear-auto reset-lists set set-mode list-apps" >&2
    echo "         get-logs export-logs clear-logs wifi-ssid backup-create backup-list backup-restore backup-restore-b64 probe-dpi probe-cancel net-info bench-strategies check-domain domain-check" >&2
    echo "         smart-status smart-sites smart-export-b64 smart-import-b64 smart-learn-once smart-reset" >&2
    echo "         home-pause net-recheck upload share changelog" >&2
    echo "         current-network list-net-strategies clear-net-strategies googlevideo-discovery orchestra-status orchestra-lock orchestra-unlock orchestra-block orchestra-unblock orchestra-clear tg-affinity" >&2
    echo "         list-catalogs get-catalog catalog-apply-module list-replaced-strategies restore-replaced-strategy" >&2
    exit 1 ;;
esac
