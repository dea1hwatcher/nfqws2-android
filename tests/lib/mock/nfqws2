#!/bin/sh
# Fake nfqws2 daemon for the regression tests.
#
# service.sh start() launches "$NFQWS_BIN" --daemon --pidfile=P ... and waits for
# that command to return, because the real nfqws2 detaches itself. This stub has
# to do the same: it spawns a long sleep in the background, records *its* PID in
# the pidfile and exits immediately. Blocking here instead would hang the whole
# test run (the pidfile PID has to stay alive for is_running() to accept it).
#
# The received argv is saved so tests can assert the assembled startup arguments.
# Known options for unsupported_opts detection: lua-desync filter-tcp payload lua-init dry-run
:

# The background copy that keeps the pidfile process alive. It re-runs this very
# script so that the process command line still names bin/nfqws2: is_running()
# verifies the pidfile points at our binary, and a bare `sleep` would be
# rejected as a recycled PID.
case "${1:-}" in
  __stay)
    trap 'exit 0' TERM INT HUP
    while :; do sleep 1; done ;;
esac

[ -n "$MOCK_NFQWS_ARGS_FILE" ] && printf '%s\n' "$*" > "$MOCK_NFQWS_ARGS_FILE"

pidfile=""
for a in "$@"; do
  case "$a" in
    --dry-run)
      case "${MOCK_NFQWS_DRY_RUN_FAIL:-}" in
        ''|0) echo "command line parameters verified"; exit 0 ;;
        *) echo "mock nfqws2: invalid argument in dry-run"; exit "$MOCK_NFQWS_DRY_RUN_FAIL" ;;
      esac
      ;;
    --pidfile=*) pidfile="${a#--pidfile=}" ;;
  esac
done

# MOCK_NFQWS_FAIL makes the stub die the way a broken daemon would. It says
# something first: service.sh reports the last lines of the startup log when the
# daemon refuses to come up, and a test cannot check that tail against silence.
case "$MOCK_NFQWS_FAIL" in
  ''|0) ;;
  *) echo "mock nfqws2: refusing to start"; exit "$MOCK_NFQWS_FAIL" ;;
esac

# MOCK_NFQWS_EBUSY=1 reproduces what the kernel does when the NFQUEUE number is
# already bound: the BIND request answers -EBUSY and the real nfqws2 exits with a
# non-zero code instead of running. The canonical pidfile sits next to the
# temporary one the caller passes, so "another daemon holds the queue" is
# exactly "that pidfile exists and its process lives". start() removes the
# pidfile before launching, so a plain start still works with the flag set.
if [ -n "${MOCK_NFQWS_EBUSY:-}" ] && [ -n "$pidfile" ]; then
  case "$pidfile" in
    */*) holder="${pidfile%/*}/nfqws2.pid" ;;
    *)   holder="nfqws2.pid" ;;
  esac
  if [ -f "$holder" ] && kill -0 "$(cat "$holder" 2>/dev/null)" 2>/dev/null; then
    echo "nfq_create_queue(): Device or resource busy"
    exit 1
  fi
fi

if [ -n "$pidfile" ]; then
  sh "$0" __stay &
  printf '%s\n' "$!" > "$pidfile"
fi

exit 0
